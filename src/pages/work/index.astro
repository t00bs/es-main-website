---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import SectionLabel from "@/components/Site/SectionLabel.astro";
import WorkCard from "@/components/Site/WorkCard.astro";
import caseStudies from "../../data/case-studies.json";

const sorted = [...caseStudies].sort((a, b) => a.order - b.order);

// Category tags (capitalised) followed by the service tags shown on the
// case-study pages.
const TAG_LABELS: Record<string, string> = {
  design: "Design",
  automation: "Automation",
  portals: "Portals",
};
const cardTags = (item: (typeof caseStudies)[number]) => [
  ...item.tags.map((tag) => TAG_LABELS[tag] ?? tag),
  ...item.services,
];
---

<Layout
  title="Work"
  description="Portals, automations, brands and the occasional machine that learns."
>
  <Section containerClass="section-split reveal-block" paddingBottom="small">
    <SectionLabel highlight="Work worth staring at." />
    <p class="statement">
      Portals, automations, brands and the occasional machine that learns. Every
      project below shipped, and every client is still speaking to us.
    </p>
  </Section>

  <Section paddingTop="none" containerClass="hover-zoom">
    {
      /* 9:16 cards like the homepage rows, four across at most so every card
        stays wide enough for its longest tag. */
    }
    <Grid
      xsmall={1}
      small={2}
      medium={3}
      large={4}
      class="work-grid width-full reveal-group"
    >
      {
        sorted.map((item) => (
          <WorkCard
            src={item.cardImage}
            title={item.title}
            subtitle={item.subtitle}
            showArrow
            href={`/work/${item.id}`}
            tags={cardTags(item)}
            portrait
          />
        ))
      }
    </Grid>
  </Section>
</Layout>
