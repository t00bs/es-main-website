---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import TickerRow from '../../components/TickerRow.astro';
import SectionRule from '../../components/SectionRule.astro';
import WorkCard from '../../components/WorkCard.astro';
import { CASE_STUDIES } from '../../data/case-studies';
---

<Layout title="Electric Sheep — Work">
  <div class="section-grid intro">
    <div class="label-readable"><SectionLabel highlight="Work worth staring at." /></div>
    <span class="statement"
      >Portals, automations, brands and the occasional machine that learns. Every project below
      shipped, and every client is still speaking to us.</span
    >
  </div>

  <div class="rule-wrap">
    <TickerRow />
    <SectionRule />
  </div>

  <div class="hover-zoom work-grid">
    {
      CASE_STUDIES.map((c) => (
        <WorkCard src={c.cardImage} title={c.title} subtitle={c.subtitle} showArrow href={`/work/${c.id}`} />
      ))
    }
    <WorkCard title="Your project here." subtitle="Say hello and we'll talk" showArrow href="/contact" />
  </div>
</Layout>

<style>
  .intro {
    padding-bottom: 48px;
  }
  .rule-wrap {
    padding: 0 var(--page-margin);
  }
  .work-grid {
    padding: 24px var(--page-margin) var(--section-pad) var(--page-margin);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 960px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
