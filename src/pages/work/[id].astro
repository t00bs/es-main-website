---
import Layout from '../../layouts/Layout.astro';
import HeroBanner from '../../components/HeroBanner.astro';
import SectionRule from '../../components/SectionRule.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import PillBadge from '../../components/PillBadge.astro';
import PixelLink from '../../components/PixelLink.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { CASE_STUDIES } from '../../data/case-studies';

export function getStaticPaths() {
  return CASE_STUDIES.map((cs) => ({ params: { id: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;
const next = CASE_STUDIES[(CASE_STUDIES.findIndex((c) => c.id === cs.id) + 1) % CASE_STUDIES.length];
---

<Layout title={`Electric Sheep — ${cs.title}`} description={cs.summary}>
  <div class="hero-wrap">
    <HeroBanner src={cs.heroImage} headline={`${cs.title}. ${cs.subtitle}.`} />
  </div>

  <div class="meta">
    <div class="meta__services">
      {cs.services.map((s) => <PillBadge color="var(--text-primary)">{s}</PillBadge>)}
    </div>
    <div class="px-hover meta__client">
      <span>{cs.client} · {cs.year}</span>
      <PixelLink href={cs.liveUrl} color="var(--text-primary)">{cs.liveLabel}</PixelLink>
    </div>
  </div>

  <div class="rule-wrap">
    <SectionRule />
  </div>

  <div class="summary">
    <span>{cs.summary}</span>
  </div>

  {
    cs.sections.map((section) =>
      section.type === 'image' ? (
        <div class="image-section">
          <div class="image-section__frame">
            <img src={section.src} alt="" loading="lazy" />
            <div class="image-section__overlay" />
            <span class="image-section__caption">{section.caption}</span>
          </div>
        </div>
      ) : (
        <div class="section-grid text-section">
          <div class="label-readable">
            <SectionLabel highlight={section.label} />
          </div>
          <span class="text-section__body">{section.body}</span>
        </div>
      )
    )
  }

  {
    cs.quote && (
      <div data-theme="dark" class="quote">
        <PillBadge color="var(--es-cream)">Customer Stories</PillBadge>
        <span class="quote__text">{cs.quote.text}</span>
        <span class="quote__author">{cs.quote.author}</span>
      </div>
    )
  }

  <div class="hover-zoom px-hover next">
    <FeatureCard
      src={next.cardImage}
      headline={`Next: ${next.title}.`}
      linkText="View case study"
      href={`/work/${next.id}`}
    />
  </div>
</Layout>

<style>
  .hero-wrap {
    padding: 10px var(--page-margin) 24px var(--page-margin);
  }
  .meta {
    padding: 0 var(--page-margin) 24px var(--page-margin);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--grid-gap);
    flex-wrap: wrap;
  }
  .meta__services {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .meta__client {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .meta__client span {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-none);
    color: var(--text-primary);
  }
  .rule-wrap {
    padding: 0 var(--page-margin);
  }
  .summary {
    padding: 48px var(--page-margin) 16px var(--page-margin);
  }
  .summary span {
    display: block;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-statement);
    line-height: var(--leading-body);
    color: var(--text-primary);
    max-width: 1080px;
  }
  .text-section {
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .text-section__body {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-section-label);
    line-height: var(--leading-body);
    color: var(--text-primary);
    max-width: 760px;
  }
  .image-section {
    padding: 16px var(--page-margin);
  }
  .image-section__frame {
    position: relative;
    height: 515px;
    overflow: hidden;
    background-color: var(--surface-placeholder);
  }
  .image-section__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-section__overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-protect);
  }
  .image-section__caption {
    position: absolute;
    left: var(--card-pad);
    bottom: 16px;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    color: var(--es-cream);
  }
  .quote {
    background-color: var(--es-ink);
    margin-top: 48px;
    padding: var(--section-pad) var(--page-margin);
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }
  .quote__text {
    font-family: var(--font-serif-quote);
    font-style: italic;
    font-size: var(--text-card-title);
    line-height: var(--leading-tight);
    color: var(--es-cream);
    max-width: 900px;
  }
  .quote__author {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: var(--leading-none);
    color: var(--es-cream);
  }
  .next {
    padding: var(--section-pad) var(--page-margin);
  }
</style>
