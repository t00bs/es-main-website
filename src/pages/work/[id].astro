---
// Dynamic route: one page per case study. The template itself lives in
// components/CaseStudyPage.astro — edit it there, and do not rename this file
// (the [id] brackets are what make the route dynamic).
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import caseStudies from '../../data/case-studies.json';

export function getStaticPaths() {
  const sorted = [...caseStudies].sort((a, b) => a.order - b.order);
  return sorted.map((cs, i) => ({
    params: { id: cs.id },
    props: { cs, next: sorted[(i + 1) % sorted.length] },
  }));
}

const { cs, next } = Astro.props;
---

<CaseStudyPage cs={cs} next={next} />
