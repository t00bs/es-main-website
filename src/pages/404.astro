---
// Custom 404. Builds to /404.html, which Vercel serves with a 404 status for
// any unmatched URL on a static deploy.
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Wrapper/Section.astro";
import SectionLabel from "@/components/Site/SectionLabel.astro";
import PixelLink from "@/components/Site/PixelLink.astro";
---

<Layout title="Page not found" description="This page wandered off.">
  <Section containerClass="section-split reveal-block">
    <SectionLabel highlight="This page has wandered off." />
    <div class="not-found__content">
      <span class="not-found__code" aria-hidden="true">404</span>
      <p class="statement">
        Sheep escape sometimes. Whatever you were looking for isn't here — it
        may have moved, or it may never have existed. We're probably close to
        finding out.
      </p>
      <div class="px-hover not-found__links">
        <PixelLink href="/" color="var(--text)" fontSize={24}
          >Back to the flock</PixelLink
        >
        <PixelLink href="/work" color="var(--text)" fontSize={24}
          >View our work</PixelLink
        >
        <PixelLink href="/contact" color="var(--text)" fontSize={24}>
          Tell us what you were after
        </PixelLink>
      </div>
    </div>
  </Section>
</Layout>

<style>
  @layer components {
    .not-found__content {
      display: flex;
      min-height: 45vh;
      flex-direction: column;
      gap: var(--space-8);
      align-items: flex-start;
    }
    .not-found__code {
      font-family: var(--font-pixel);
      font-size: clamp(5rem, 12vw, 10rem);
      line-height: var(--line-height-small);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
    }
    .not-found__content .statement {
      max-width: 45ch;
    }
    .not-found__links {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      align-items: flex-start;
    }
  }
</style>
