---
import Layout from '../layouts/Layout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import ClientLogoBar from '../components/ClientLogoBar.astro';
import ServicesBreakdown from '../components/ServicesBreakdown.astro';
import ResultsStrip from '../components/ResultsStrip.astro';
import ProcessSection from '../components/ProcessSection.astro';
import WorkTabs from '../components/WorkTabs.astro';
import PixelLink from '../components/PixelLink.astro';
import ServicesMarquee from '../components/ServicesMarquee.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FeatureCard from '../components/FeatureCard.astro';
import caseStudies from '../data/case-studies.json';

const sorted = [...caseStudies].sort((a, b) => a.order - b.order);
const testimonials = sorted.filter((item) => item.quote);

// Hero rotation: brand imagery bookends the top case study's card image.
const heroSlides = [
  '/assets/images/hero-sheep.png',
  ...(sorted.length ? [sorted[0].cardImage] : []),
  '/assets/images/toby.jpg',
];
---
<Layout title="Electric Sheep — Home">
  <div class="hero-wrap">
    <!-- Hero timing: intervalMs = how long each slide holds, transitionMs =
         pixelation/glitch speed. Tweak here. -->
    <HeroSlideshow headline="Sheep by name. Not by nature." slides={heroSlides} intervalMs={3500} transitionMs={700} />
  </div>
  <ClientLogoBar />
  <WorkTabs />
  <div class="px-hover view-all">
    <PixelLink href="/work" color="var(--text-primary)">View all work</PixelLink>
  </div>
  <ServicesMarquee />
  <ServicesBreakdown />
  <ResultsStrip />
  <ProcessSection />
  <div class="px-hover testimonials">
    {
      testimonials.map((item) => (
        <TestimonialCard src={item.testimonialImage || item.cardImage} quote={item.quote!.text} linkText={`View ${item.title} Case Study`} href={`/work/${item.id}`} />
      ))
    }
  </div>
  <div class="inverse-section section-grid about">
    <SectionLabel highlight="Electric Sheep?">Do Androids dream of</SectionLabel>
    <span class="statement about__body">{
        'We don’t know. But we’re probably close to finding out.\nFounded in 2023, Electric Sheep sits at the intersection of technology and humanity. We design & build digital tools that are automated by AI, but driven by people.'
      }</span>
  </div>
  <div class="hover-zoom px-hover feature">
    <FeatureCard src="/assets/images/toby.jpg" headline="Big nose, bigger ideas." linkText="Meet Toby" href="/about" />
  </div>
</Layout>
<style>
  .hero-wrap {
    padding: 10px var(--page-margin) var(--section-pad) var(--page-margin);
  }
  .view-all {
    padding: 0 var(--page-margin) var(--section-pad) var(--page-margin);
    display: flex;
    justify-content: flex-end;
  }
  .testimonials {
    padding: var(--section-pad) var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
  }
  .about__body {
    color: var(--text-on-inverse);
  }
  .feature {
    padding: var(--section-pad) var(--page-margin);
  }
  @media (max-width: 960px) {
    .testimonials {
      grid-template-columns: 1fr;
    }
  }
</style>
