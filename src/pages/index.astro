---
import Layout from '../layouts/Layout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import WorkTabs from '../components/WorkTabs.astro';
import PixelLink from '../components/PixelLink.astro';
import ServicesMarquee from '../components/ServicesMarquee.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { CASE_STUDIES } from '../data/case-studies';

const testimonials = CASE_STUDIES.filter((c) => c.quote);
---

<Layout title="Electric Sheep — Home">
  <div class="hero-wrap">
    <HeroSlideshow headline="Sheep by name. Not by nature." />
  </div>

  <WorkTabs />

  <div class="px-hover view-all">
    <PixelLink href="/work" color="var(--text-primary)">View all work</PixelLink>
  </div>

  <ServicesMarquee />

  <div class="px-hover testimonials">
    {
      testimonials.map((c) => (
        <TestimonialCard
          src={c.cardImage}
          quote={c.quote!.text}
          linkText={`View ${c.title} Case Study`}
          href={`/work/${c.id}`}
        />
      ))
    }
  </div>

  <div data-theme="dark" class="section-grid about">
    <SectionLabel highlight="Electric Sheep?">Do Androids dream of</SectionLabel>
    <span class="statement about__body"
      >{
        'We don’t know. But we’re probably close to finding out.\nFounded in 2023, Electric Sheep sits at the intersection of technology and humanity. We design & build digital tools that are automated by AI, but driven by people.'
      }</span
    >
  </div>

  <div class="hover-zoom px-hover feature">
    <FeatureCard
      src="/assets/images/toby.jpg"
      headline="Big nose, bigger ideas."
      linkText="Meet Toby"
      href="/contact"
    />
  </div>
</Layout>

<style>
  .hero-wrap {
    padding: 10px var(--page-margin) var(--section-pad) var(--page-margin);
  }
  .view-all {
    padding: 0 var(--page-margin) var(--section-pad) var(--page-margin);
    display: flex;
    justify-content: flex-end;
  }
  .testimonials {
    padding: var(--section-pad) var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
  }
  .about {
    background-color: var(--es-ink);
  }
  .about__body {
    color: var(--es-cream);
  }
  .feature {
    padding: var(--section-pad) var(--page-margin);
  }
  @media (max-width: 960px) {
    .testimonials {
      grid-template-columns: 1fr;
    }
  }
</style>
