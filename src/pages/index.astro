---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <h1>Electric Sheep Design</h1>
    <p>New site under construction — built with Astro.</p>
  </main>
</Layout>

<style>
  main {
    display: grid;
    place-content: center;
    min-height: 100vh;
    text-align: center;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  p {
    color: #666;
  }
</style>
