---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import HeroSlideshow from "@/components/Site/HeroSlideshow.astro";
import ClientLogoBar from "@/components/Site/ClientLogoBar.astro";
import ServicesBreakdown from "@/components/Site/ServicesBreakdown.astro";
import ProcessSection from "@/components/Site/ProcessSection.astro";
import WorkCarousels from "@/components/Site/WorkCarousels.astro";
import PixelLink from "@/components/Site/PixelLink.astro";
import TestimonialCard from "@/components/Site/TestimonialCard.astro";
import SectionLabel from "@/components/Site/SectionLabel.astro";
import FeatureCard from "@/components/Site/FeatureCard.astro";
import caseStudies from "../data/case-studies.json";
import heroSlidesData from "../data/hero-slides.json";

const sorted = [...caseStudies].sort((a, b) => a.order - b.order);
const testimonials = sorted.filter((item) => item.quote);

// Hero rotation comes from the hero-slides collection, in file order.
const slides = heroSlidesData.map((item) => item.image).filter(Boolean);
---

<Layout>
  {/* Hero timing: intervalMs = how long each slide holds, transitionMs =
      pixelation/glitch speed. Tweak here. */}
  <Section paddingTop="even">
    <HeroSlideshow
      headline="Sheep by name. Not by nature."
      slides={slides}
      intervalMs={3500}
      transitionMs={700}
    />
  </Section>

  <ClientLogoBar />

  <WorkCarousels />

  <Section paddingTop="small" align="end" containerClass="reveal-block">
    <div class="px-hover">
      <PixelLink href="/work" color="var(--text)">View all work</PixelLink>
    </div>
  </Section>

  <ServicesBreakdown />

  <Section>
    <Grid
      xsmall={1}
      medium={2}
      class="px-hover testimonials width-full reveal-group"
    >
      {
        testimonials.map((item) => (
          <TestimonialCard
            src={item.testimonialImage || item.cardImage}
            quote={item.quote!.text}
            linkText={`View ${item.title} Case Study`}
            href={`/work/${item.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  <ProcessSection />

  <Section class="theme-invert">
    <div class="section-split width-full reveal-block">
      <SectionLabel highlight="Electric Sheep?">Do Androids dream of</SectionLabel
      >
      <p class="statement">We don’t know. But we’re probably close to finding out. Founded in 2023, Electric Sheep sits at the intersection of technology and humanity. We design &amp; build digital tools that are automated by technology, but driven by people. </p>
    </div>
    <div class="hover-zoom px-hover width-full reveal-block">
      <FeatureCard
        src="/assets/images/toby.jpg"
        headline="Big nose, bigger ideas."
        linkText="Meet Toby"
        href="/about"
      />
    </div>
  </Section>
</Layout>
