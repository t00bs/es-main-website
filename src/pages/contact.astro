---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import TickerRow from '../components/TickerRow.astro';
import SectionRule from '../components/SectionRule.astro';
import PixelLink from '../components/PixelLink.astro';
---

<Layout title="Electric Sheep — Contact">
  <div class="section-grid intro">
    <SectionLabel highlight="Start a conversation." />
    <div class="intro__content">
      <span class="statement"
        >Tell us what's slowing you down. We'll tell you honestly whether a robot can do it — and
        design the tool if one can.</span
      >
      <div class="px-hover">
        <PixelLink href="mailto:hello@electricsheep.design" color="var(--text-primary)" fontSize={24}>
          hello@electricsheep.design
        </PixelLink>
      </div>
    </div>
  </div>

  <div class="rule-wrap">
    <TickerRow />
    <SectionRule />
  </div>

  <div class="find-us">
    <div class="find-us__map">
      <img src="/assets/images/jersey-map.svg" alt="Map of Jersey" />
    </div>
    <div class="find-us__details">
      <span class="find-us__address">{'Find us at\n10 Minden Street\nSt Helier, Jersey\nJE2 4WR'}</span>
      <span class="find-us__aside">Coffee is good. Toby accepts visitors by appointment.</span>
    </div>
  </div>
</Layout>

<style>
  .intro {
    padding-bottom: 48px;
  }
  .intro__content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: flex-start;
  }
  .intro__content .statement {
    max-width: 820px;
  }
  .rule-wrap {
    padding: 0 var(--page-margin);
  }
  .find-us {
    padding: 24px var(--page-margin) var(--section-pad) var(--page-margin);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
  }
  .find-us__map {
    background-color: var(--es-cream);
    border: 1px solid rgba(0, 0, 0, 0.5);
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 440px;
  }
  .find-us__map img {
    width: 80%;
    height: auto;
    display: block;
  }
  .find-us__details {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 12px;
  }
  .find-us__address {
    font-family: var(--font-sans);
    font-size: var(--text-section-label);
    line-height: var(--leading-body);
    color: var(--text-primary);
    white-space: pre-line;
  }
  .find-us__aside {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    line-height: var(--leading-body);
    color: var(--text-primary);
    opacity: 0.7;
  }
  @media (max-width: 960px) {
    .find-us {
      grid-template-columns: 1fr;
    }
  }
</style>
