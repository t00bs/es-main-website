---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import SectionLabel from "@/components/Site/SectionLabel.astro";
import PixelLink from "@/components/Site/PixelLink.astro";
---

<Layout title="Contact" description="Tell us what's slowing you down.">
  <Section containerClass="section-split reveal-block" paddingBottom="small">
    <SectionLabel highlight="Start a conversation." />
    <div class="contact__intro">
      <p class="statement">
        Tell us what's slowing you down. We'll tell you honestly whether a robot
        can do it — and design the tool if one can.
      </p>
      <div class="px-hover">
        <PixelLink
          href="mailto:hello@electricsheep.design"
          color="var(--text)"
          fontSize={24}
        >
          hello@electricsheep.design
        </PixelLink>
      </div>
    </div>
  </Section>

  <Section paddingTop="none">
    <Grid xsmall={1} medium={2} class="width-full reveal-block">
      {
        /* Google's keyless embed, which has no dark style of its own — the
          filter below turns it dark. */
      }
      <div class="find-us__map">
        <iframe
          title="Map showing Electric Sheep at 10 Minden Street, St Helier, Jersey"
          src="https://maps.google.com/maps?q=10+Minden+Street,+St+Helier,+Jersey+JE2+4WR&z=16&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="find-us__details">
        <span class="find-us__address">
          {"Find us at\n10 Minden Street\nSt Helier, Jersey\nJE2 4WR"}
        </span>
        <span class="find-us__aside"
          >Coffee is good. Toby accepts visitors by appointment.</span
        >
      </div>
    </Grid>
  </Section>
</Layout>

<style>
  @layer components {
    .contact__intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      align-items: flex-start;
    }
    .contact__intro .statement {
      max-width: 50ch;
    }
    .find-us__map {
      position: relative;
      min-height: 27.5rem;
      overflow: hidden;
      border: var(--rule-thin) solid var(--rule-hairline);
      border-radius: var(--radius-small);
      background-color: var(--surface-placeholder);
    }
    /* Inverting the light map and turning its hues back round gives a dark
       map whose land, water and roads keep their relationships. Colour is
       muted rather than dropped, so Google's pin still reads as red. */
    .find-us__map iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      filter: invert(90%) hue-rotate(180deg) saturate(55%) contrast(90%);
    }
    .find-us__details {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: var(--space-2);
    }
    .find-us__address {
      font-family: var(--primary-family);
      font-size: var(--h4);
      line-height: var(--line-height-huge);
      color: var(--text);
      white-space: pre-line;
    }
    .find-us__aside {
      font-family: var(--primary-family);
      font-size: var(--text-small);
      line-height: var(--line-height-huge);
      color: var(--text);
      opacity: 0.7;
    }
  }
</style>
