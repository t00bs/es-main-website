---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import SectionLabel from "@/components/Site/SectionLabel.astro";
import PixelLink from "@/components/Site/PixelLink.astro";
import PillBadge from "@/components/Site/PillBadge.astro";
import SheepdogDemo from "@/components/Site/SheepdogDemo.astro";
import Button from "@/components/Button.astro";
import { SITE_URL } from "@/consts.ts";
import sheepData from "../data/sheep.json";
import stepsData from "../data/sheepdog-steps.json";
import plansData from "../data/sheepdog-plans.json";

const sheep = sheepData;
const steps = stepsData;
const plans = plansData;

// Service + Offer markup, so answer engines read the prices as data. Built
// from the plans JSON, so it follows the visual editor.
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${SITE_URL}/sheepdog/#service`,
  name: "Sheepdog",
  serviceType: "Managed website updates",
  description:
    "A managed website service from Electric Sheep. AI assistants make the changes a client's team asks for in Slack, test them and send a preview; a person the client chooses decides what goes live, and anything involving code or tracking is reviewed by Electric Sheep.",
  url: `${SITE_URL}/sheepdog/`,
  provider: { "@id": `${SITE_URL}/#organization` },
  areaServed: ["Jersey", "United Kingdom"],
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: `Sheepdog ${plan.name}`,
    description: plan.body,
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: plan.amount,
      priceCurrency: "GBP",
      unitText: "MON",
    },
  })),
};
---

<Layout
  title="Sheepdog: website updates from your team chat"
  description="Sheepdog is a managed website service from Electric Sheep. Your team asks for changes in Slack, checks a preview and screenshots, and presses publish. From £195 a month."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />

  {/* Hero */}
  <Section paddingBottom="small" containerClass="reveal-block">
    <div class="sd-hero">
      <div class="sd-hero__title">
        <SectionLabel highlight="Sheepdog" />
        <h1>Your website team, in your team chat.</h1>
      </div>
      <div class="sd-hero__aside">
        <p class="sd-hero__lede">
          Sheepdog is a managed website service from Electric Sheep. Post a
          change in Slack the way you'd brief a person. A few minutes later you
          get a preview link, phone and desktop screenshots and the test results
          in the same thread. Nothing goes live until someone you trust presses
          the button.
        </p>
        <Button id="sd-watch">Play the two-minute demo</Button>
      </div>
    </div>
  </Section>

  {/* Demo */}
  <Section paddingTop="small">
    <SheepdogDemo />
  </Section>

  {/* The question */}
  <Section
    containerClass="section-split reveal-block"
    paddingTop="small"
    paddingBottom="small"
  >
    <SectionLabel tag="h2" highlight="Can AI update my website safely?" />
    <p class="note">
      Yes, as long as it can't publish on its own. Sheepdog drafts every change
      on a private copy of your site, tests it and sends a preview link with
      desktop and phone screenshots. Nothing goes live until someone you've
      approved presses publish, and any change can be undone for seven days.
      Code, tracking and contact details go to Toby first. If your team is happy
      working in Webflow, Webflow's Slack agent is free while it's in beta (as
      of November 2026) and may be enough. Sheepdog is for teams who would
      rather send a message than learn a CMS.
    </p>
  </Section>

  {/* How it works */}
  <Section>
    <div class="section-split sd-band-head reveal-block">
      <SectionLabel tag="h2" highlight="How it works" />
      <p class="sd-band-lede">
        One thread, one change, one button. Each request gets its own private
        copy of your site, so two people can ask for different things at the
        same time without treading on each other. Follow-ups in the same thread
        update the same preview.
      </p>
    </div>
    <ol class="sd-timeline reveal-group">
      {
        steps.map((item) => (
          <li>
            <span class="sd-timeline__number">{item.number}</span>
            <h3 class="sd-timeline__title">{item.title}</h3>
            <span class="sd-timeline__body">{item.body}</span>
          </li>
        ))
      }
    </ol>
    <div class="sd-approve reveal-block">
      <div>
        <h3 class="sd-approve__title">Content and on-brand design</h3>
        <p class="sd-approve__body">
          News, events, team, jobs, copy edits, and design changes that use your
          existing colours and components. The people you choose publish these
          themselves once the checks pass.
        </p>
      </div>
      <div>
        <h3 class="sd-approve__title">Code, tracking and contact details</h3>
        <p class="sd-approve__body">
          New scripts, analytics, cookie changes, forms, phone numbers, bank
          details and anything off-brand come to Toby, who checks the change and
          the code before it goes live. Usually the same day.
        </p>
      </div>
    </div>
  </Section>

  {/* The flock */}
  <Section>
    <SectionLabel tag="h2" highlight="flock.">Meet the</SectionLabel>
    <Grid xsmall={1} small={2} large={5} class="width-full reveal-group">
      {
        sheep.map((item) => (
          <article class="sheep">
            <div class="sheep__frame">
              <img
                src={item.image}
                alt={item.alt}
                width="1036"
                height="717"
                loading="lazy"
              />
            </div>
            <div class="sheep__badge">
              <PillBadge color="var(--text)">{item.status}</PillBadge>
            </div>
            <span class="sheep__plan">{item.plan}</span>
            <h3 class="sheep__name">{item.name}</h3>
            <p class="sheep__body">{item.body}</p>
          </article>
        ))
      }
    </Grid>
  </Section>

  {/* Still human */}
  <Section containerClass="section-split reveal-block">
    <SectionLabel tag="h2" highlight="Still very much human." />
    <p class="note">
      Sheepdog doesn't replace Toby. He sets up every client's crew himself,
      writes the rules each sheep works to, and reviews any change that touches
      code, tracking or your contact details. You can still call or email him,
      same as always. The sheep take the small jobs, so he has more time for the
      bigger ones.
    </p>
  </Section>

  {/* Pricing */}
  <Section>
    <div class="section-split sd-band-head reveal-block">
      <SectionLabel tag="h2" highlight="per site.">One flat fee</SectionLabel>
      <p class="sd-band-lede">
        No hour caps and no AI credits to top up. Bigger jobs, like a new page
        type or an integration, are quoted separately, and Sheepdog tells you
        when a request is one of those.
      </p>
    </div>
    <div class="sd-prices reveal-group">
      {
        plans.map((item) => (
          <div class:list={["sd-tier", item.offer && "sd-tier--offer"]}>
            <div class="sd-tier__head">
              <h3 class="sd-tier__name">{item.name}</h3>
              {item.offer && (
                <PillBadge color="var(--text)" filled>
                  {item.offer}
                </PillBadge>
              )}
            </div>
            <span class="sd-tier__price">
              {item.price}
              <span class="sd-tier__period"> {item.period}</span>
            </span>
            <p class="sd-tier__body">{item.body}</p>
            <span class="sd-tier__allowance">{item.allowance}</span>
          </div>
        ))
      }
    </div>
    <div class="sd-price-foot reveal-block">
      <span>Setup £750 if we built your site, £1,500 if we didn't.</span>
      <span>Setup is waived with a new build on a 12-month term.</span>
      <span
        >Prices per site, plus GST where it applies, as of November 2026.</span
      >
      <span
        >Existing Electric Sheep clients get the Content plan free for three
        months.</span
      >
    </div>
  </Section>

  {/* Next step */}
  <Section containerClass="px-hover reveal-block gap-3">
    <PixelLink
      href="mailto:hello@electricsheep.design?subject=Sheepdog"
      color="var(--text)"
      fontSize={24}>Ask about Sheepdog</PixelLink
    >
    <PixelLink href="/contact" color="var(--text)" fontSize={24}
      >Start a conversation</PixelLink
    >
  </Section>
</Layout>

<style>
  @layer components {
    /* Hero: headline left, the pitch and the demo button right. */
    .sd-hero {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: var(--space-6) var(--space-8);
      align-items: end;
      width: 100%;
    }
    .sd-hero__title {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      align-items: flex-start;
    }
    .sd-hero__aside {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      align-items: flex-start;
    }
    .sd-hero__lede {
      max-width: 34em;
      font-size: var(--text-large);
      line-height: var(--line-height-huge);
      color: var(--text);
    }
    @media (width < 60rem) {
      .sd-hero {
        grid-template-columns: 1fr;
      }
    }

    /* Section head: label beside a lede, as `.section-split` but full width. */
    .sd-band-head {
      width: 100%;
    }
    .sd-band-lede {
      max-width: 40em;
      font-size: var(--text-large);
      line-height: var(--line-height-huge);
      color: var(--text);
    }

    /* How it works: a timeline, one rule with a dot per step. */
    .sd-timeline {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: calc(var(--rule-thin) * 2) solid var(--rule-strong);
    }
    .sd-timeline li {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5) var(--space-5) 0 0;
    }
    .sd-timeline li::before {
      content: "";
      position: absolute;
      top: -0.4375rem;
      left: 0;
      width: 0.75rem;
      height: 0.75rem;
      border-radius: var(--radius-round);
      background-color: var(--text);
    }
    .sd-timeline__number {
      font-family: var(--font-pixel);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
      opacity: 0.7;
    }
    .sd-timeline__title {
      font-family: var(--primary-family);
      font-weight: var(--primary-regular);
      font-size: var(--h4);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-timeline__body {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
    }
    @media (width < 60rem) {
      .sd-timeline {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-6) 0;
        border-top: 0;
      }
      .sd-timeline li {
        border-top: calc(var(--rule-thin) * 2) solid var(--rule-strong);
      }
    }
    @media (width < 30rem) {
      .sd-timeline {
        grid-template-columns: 1fr;
      }
    }

    /* Who publishes what: two panels under the timeline. */
    .sd-approve {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--rule-thin);
      width: 100%;
      overflow: hidden;
      border: var(--rule-thin) solid var(--rule-hairline);
      border-radius: var(--radius-small);
      background-color: var(--rule-hairline);
    }
    .sd-approve > div {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--card-pad);
      background-color: var(--background);
    }
    .sd-approve__title {
      font-size: var(--h5);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-approve__body {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
    }
    @media (width < 45rem) {
      .sd-approve {
        grid-template-columns: 1fr;
      }
    }

    /* Pricing: three cards in one ruled frame. */
    .sd-prices {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      overflow: hidden;
      border: var(--rule-thin) solid var(--rule-strong);
      border-radius: var(--radius-small);
    }
    .sd-tier {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--card-pad) var(--card-pad) var(--space-6);
      border-right: var(--rule-thin) solid var(--rule-strong);
    }
    .sd-tier:last-child {
      border-right: 0;
    }
    .sd-tier--offer {
      background-color: color-mix(in lab, var(--text) 6%, var(--background));
    }
    .sd-tier__head {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      align-items: center;
      justify-content: space-between;
      min-height: 2.5rem;
    }
    .sd-tier__name {
      font-family: var(--font-pixel);
      font-size: var(--h5);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
    }
    .sd-tier__price {
      font-size: var(--display);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-tier__period {
      font-size: var(--text-main);
      opacity: 0.7;
    }
    .sd-tier__body {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
    }
    .sd-tier__allowance {
      margin-top: auto;
      padding-top: var(--space-3);
      border-top: var(--rule-thin) solid var(--rule-hairline);
      font-family: var(--font-pixel);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
      opacity: 0.7;
    }
    .sd-price-foot {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      width: 100%;
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
      opacity: 0.7;
    }
    @media (width < 60rem) {
      .sd-prices {
        grid-template-columns: 1fr;
      }
      .sd-tier {
        border-right: 0;
        border-bottom: var(--rule-thin) solid var(--rule-strong);
      }
      .sd-tier:last-child {
        border-bottom: 0;
      }
    }

    /* A sheep card: render, status pill, then the same pixel label / title /
       body stack as the homepage service pillars. */
    .sheep {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .sheep__frame {
      overflow: hidden;
      border-radius: var(--radius-small);
      background-color: var(--surface-placeholder);
    }
    .sheep__frame img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1036 / 717;
      object-fit: cover;
    }
    .sheep__badge {
      padding-top: var(--space-1);
    }
    .sheep__plan {
      font-family: var(--font-pixel);
      font-size: var(--h5);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
    }
    .sheep__name {
      font-family: var(--primary-family);
      font-weight: var(--primary-regular);
      font-size: var(--h3);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sheep__body {
      font-family: var(--primary-family);
      font-weight: var(--primary-regular);
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
      text-wrap: pretty;
    }
  }
</style>
