---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import PixelLink from "@/components/Site/PixelLink.astro";
import PillBadge from "@/components/Site/PillBadge.astro";
import Mark from "@/components/Site/Mark.astro";
import SheepdogDemo from "@/components/Site/SheepdogDemo.astro";
import Button from "@/components/Button.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import { SITE_URL } from "@/consts.ts";
import sheepData from "../data/sheep.json";
import stepsData from "../data/sheepdog-steps.json";
import plansData from "../data/sheepdog-plans.json";
import faqsData from "../data/sheepdog-faqs.json";
import benefitsData from "../data/sheepdog-benefits.json";

const sheep = sheepData;
const steps = stepsData;
const plans = plansData;
const faqs = faqsData;
const benefits = benefitsData;

// The hero's check row: short, one claim each.
const heroChecks = [
  "No CMS logins",
  "Previews in minutes",
  "Nothing goes live until you publish",
  "From £195 a month",
];

// Service + Offer markup, so answer engines read the prices as data. Built
// from the plans JSON, so it follows the visual editor.
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${SITE_URL}/sheepdog/#service`,
  name: "Sheepdog",
  serviceType: "Managed website updates",
  description:
    "A managed website service from Electric Sheep. Your team asks for website changes in Slack, gets a tested preview in minutes and publishes when it's ready.",
  url: `${SITE_URL}/sheepdog/`,
  provider: { "@id": `${SITE_URL}/#organization` },
  areaServed: ["Jersey", "United Kingdom"],
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: `Sheepdog ${plan.name}`,
    description: plan.body,
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: plan.amount,
      priceCurrency: "GBP",
      unitText: "MON",
    },
  })),
};

// FAQPage markup from the same JSON as the accordion.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  title="Sheepdog: website updates from your team chat"
  description="Ask for website changes in Slack, get a tested preview in minutes and publish when you're ready. Sheepdog by Electric Sheep, from £195 a month."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  {/* Hero: the problem, centred SaaS-style with two actions */}
  <Section paddingBottom="small" containerClass="reveal-block">
    <div class="sd-hero">
      <PillBadge color="var(--text)">Content Sheep is available now</PillBadge>
      <h1 class="sd-hero__title">
        Small website changes shouldn't take three days.
      </h1>
      <p class="sd-hero__lede">
        Ask for website changes in Slack and check a tested preview a few
        minutes later.
      </p>
      <div class="sd-hero__actions">
        <Button
          element="link"
          href="mailto:hello@electricsheep.design?subject=Sheepdog"
          >Ask about Sheepdog</Button
        >
        <Button id="sd-watch" emphasis="secondary"
          >Play the two-minute demo</Button
        >
      </div>
      <ul class="sd-hero__checks">
        {
          heroChecks.map((text) => (
            <li>
              <Mark kind="yes" />
              {text}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* The fix: demo and outcomes, on the light band */}
  <Section theme="light" gap="6">
    <div class="section-split sd-band-head reveal-block">
      <h2>Your website team, in your team chat</h2>
      <p class="sd-band-lede">
        Post the change in Slack the way you'd message a colleague. Sheepdog
        makes it on a private copy of your site and sends a tested preview back
        to the thread. When it looks right, you press publish.
      </p>
    </div>
    <div class="width-full">
      <SheepdogDemo />
    </div>
    <Grid xsmall={1} small={3} large={3} class="width-full reveal-group">
      {
        benefits.map((item) => (
          <div class="sd-benefit">
            <Mark kind="yes" />
            <h3 class="sd-benefit__title">{item.title}</h3>
            <p class="sd-benefit__body">{item.body}</p>
          </div>
        ))
      }
    </Grid>
  </Section>

  {/* How it works */}
  <Section>
    <div class="section-split sd-band-head reveal-block">
      <h2>How it works</h2>
      <p class="sd-band-lede">
        Each request gets its own private copy of your site, so several people
        can ask at once. Follow-ups in the thread update the same preview.
      </p>
    </div>
    <ol class="sd-timeline reveal-group">
      {
        steps.map((item) => (
          <li>
            <span class="sd-timeline__number">{item.number}</span>
            <h3 class="sd-timeline__title">{item.title}</h3>
            <span class="sd-timeline__body">{item.body}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* FAQ */}
  <Section containerClass="section-split sd-band-head reveal-block">
    <h2>Questions</h2>
    <Accordion class="sd-faq" openFirst>
      {
        faqs.map((item) => (
          <AccordionItem heading={item.question}>
            <p>{item.answer}</p>
          </AccordionItem>
        ))
      }
    </Accordion>
  </Section>

  {/* The flock */}
  <Section theme="light">
    <div class="section-split sd-band-head reveal-block">
      <h2>Meet the flock</h2>
      <p class="sd-band-lede">
        One sheep for each kind of job. Start with Content and add the rest when
        you need them.
      </p>
    </div>
    <Grid xsmall={1} small={2} large={5} class="width-full reveal-group">
      {
        sheep.map((item) => (
          <article class="sheep">
            <div class="sheep__frame">
              <img
                src={item.image}
                alt={item.alt}
                width="1036"
                height="717"
                loading="lazy"
              />
            </div>
            <div class="sheep__badge">
              <PillBadge color="var(--text)">{item.status}</PillBadge>
            </div>
            <span class="sheep__plan">{item.plan}</span>
            <h3 class="sheep__name">{item.name}</h3>
            <p class="sheep__body">{item.body}</p>
          </article>
        ))
      }
    </Grid>
  </Section>

  {/* Still human */}
  <Section containerClass="section-split sd-band-head reveal-block">
    <h2>Still very much human</h2>
    <p class="note">
      Toby sets up every flock and writes the rules each sheep follows. You can
      still call him, same as always.
    </p>
  </Section>

  {/* Pricing */}
  <Section>
    <div class="section-split sd-band-head reveal-block">
      <h2>Pricing</h2>
      <p class="sd-band-lede">
        One flat fee per site, with no hour caps or AI credits. Bigger jobs,
        like a new page type, are quoted separately.
      </p>
    </div>
    <div class="sd-prices reveal-group">
      {
        plans.map((item) => (
          <div class:list={["sd-tier", item.offer && "sd-tier--offer"]}>
            <div class="sd-tier__head">
              <h3 class="sd-tier__name">{item.name}</h3>
              {item.offer && (
                <PillBadge color="var(--text)" filled>
                  {item.offer}
                </PillBadge>
              )}
            </div>
            <span class="sd-tier__price">
              {item.price}
              <span class="sd-tier__period"> {item.period}</span>
            </span>
            <ul class="sd-tier__features">
              {item.features.map((feature) => (
                <li>
                  <Mark kind="yes" />
                  {feature}
                </li>
              ))}
            </ul>
            <span class="sd-tier__allowance">{item.allowance}</span>
          </div>
        ))
      }
    </div>
    <div class="sd-price-foot reveal-block">
      <span>Setup £750 if we built your site, £1,500 if we didn't.</span>
      <span>Setup is free with a new build on a 12-month term.</span>
      <span>Per site, plus GST, as of November 2026.</span>
      <span>Existing clients get Content free for three months.</span>
    </div>
  </Section>

  {/* Next step */}
  <Section containerClass="px-hover reveal-block gap-3">
    <PixelLink
      href="mailto:hello@electricsheep.design?subject=Sheepdog"
      color="var(--text)"
      fontSize={24}>Ask about Sheepdog</PixelLink
    >
    <PixelLink href="/contact" color="var(--text)" fontSize={24}
      >Start a conversation</PixelLink
    >
  </Section>
</Layout>

<style>
  @layer components {
    /* What your team gets: three short benefits in ruled columns. */
    .sd-benefit {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      border-top: var(--rule-thin) solid var(--rule-hairline);
      padding: var(--space-4) var(--space-5) 0 0;
    }
    .sd-benefit__title {
      font-size: var(--h4);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-benefit__body {
      max-width: 32ch;
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      /* Secondary copy sits back a step so the titles lead. */
      color: color-mix(in lab, var(--text) 72%, var(--background));
      text-wrap: pretty;
    }

    /* Hero: headline left, the pitch and the demo button right. */
    /* Hero: centred column, pill, display headline, lede, two actions. */
    .sd-hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
      width: 100%;
      padding-block: var(--space-6) var(--space-4);
      text-align: center;
    }
    .sd-hero__title {
      max-width: 16em;
      font-size: var(--display);
      text-wrap: balance;
    }
    .sd-hero__lede {
      max-width: 36em;
      font-size: var(--text-large);
      line-height: var(--line-height-huge);
      color: color-mix(in lab, var(--text) 72%, var(--background));
      text-wrap: pretty;
    }
    .sd-hero__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-3);
      margin-top: var(--space-2);
    }
    .sd-hero__checks {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-3) var(--space-5);
      margin: var(--space-2) 0 0;
      padding: 0;
      list-style: none;
    }
    .sd-hero__checks li {
      display: inline-flex;
      gap: var(--space-2);
      align-items: center;
      font-size: var(--text-small);
      color: color-mix(in lab, var(--text) 72%, var(--background));
    }

    /* Section head: a plain h2 beside its lede, on the `.section-split` grid. */
    .sd-band-head {
      width: 100%;
    }
    .sd-band-head h2 {
      padding-right: var(--space-5);
    }
    .sd-band-lede {
      max-width: 40em;
      font-size: var(--text-large);
      line-height: var(--line-height-huge);
      color: var(--text);
    }

    /* How it works: a timeline, one rule with a dot per step. */
    .sd-timeline {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: calc(var(--rule-thin) * 2) solid var(--rule-strong);
    }
    .sd-timeline li {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5) var(--space-5) 0 0;
    }
    .sd-timeline li::before {
      content: "";
      position: absolute;
      top: -0.4375rem;
      left: 0;
      width: 0.75rem;
      height: 0.75rem;
      border-radius: var(--radius-round);
      background-color: var(--text);
    }
    .sd-timeline__number {
      font-family: var(--font-pixel);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
      opacity: 0.7;
    }
    .sd-timeline__title {
      font-family: var(--primary-family);
      font-weight: var(--primary-regular);
      font-size: var(--h4);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-timeline__body {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      /* Secondary copy sits back a step so the titles lead. */
      color: color-mix(in lab, var(--text) 72%, var(--background));
      text-wrap: pretty;
    }
    @media (width < 60rem) {
      .sd-timeline {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-6) 0;
        border-top: 0;
      }
      .sd-timeline li {
        border-top: calc(var(--rule-thin) * 2) solid var(--rule-strong);
      }
    }
    @media (width < 30rem) {
      .sd-timeline {
        grid-template-columns: 1fr;
      }
    }

    /* FAQ: the Lumos accordion, kept to a readable measure. */
    .sd-faq {
      width: 100%;
      max-width: 50rem;
      border-top: var(--border-width) solid var(--border);
    }
    .sd-faq :global(.accordion_body p) {
      max-width: 60ch;
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: color-mix(in lab, var(--text) 72%, var(--background));
    }

    /* Pricing: three cards in one ruled frame. */
    .sd-prices {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      overflow: hidden;
      border: var(--rule-thin) solid var(--rule-strong);
      border-radius: var(--radius-small);
    }
    .sd-tier {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--card-pad) var(--card-pad) var(--space-6);
      border-right: var(--rule-thin) solid var(--rule-strong);
    }
    .sd-tier:last-child {
      border-right: 0;
    }
    .sd-tier--offer {
      background-color: color-mix(in lab, var(--text) 6%, var(--background));
    }
    .sd-tier__head {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      align-items: center;
      justify-content: space-between;
      min-height: 2.5rem;
    }
    .sd-tier__name {
      font-family: var(--font-pixel);
      font-size: var(--h5);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
    }
    .sd-tier__price {
      font-size: var(--display);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-tier__period {
      font-size: var(--text-main);
      opacity: 0.7;
    }
    .sd-tier__features {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .sd-tier__features li {
      display: flex;
      gap: var(--space-3);
      align-items: flex-start;
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
    }
    .sd-tier__body {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
    }
    .sd-tier__allowance {
      margin-top: auto;
      padding-top: var(--space-3);
      border-top: var(--rule-thin) solid var(--rule-hairline);
      font-family: var(--font-pixel);
      font-size: var(--text-small);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
      opacity: 0.7;
    }
    .sd-price-foot {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      width: 100%;
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
      opacity: 0.7;
    }
    @media (width < 60rem) {
      .sd-prices {
        grid-template-columns: 1fr;
      }
      .sd-tier {
        border-right: 0;
        border-bottom: var(--rule-thin) solid var(--rule-strong);
      }
      .sd-tier:last-child {
        border-bottom: 0;
      }
    }

    /* A sheep card: render, status pill, then the same pixel label / title /
       body stack as the homepage service pillars. */
    .sheep {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .sheep__frame {
      overflow: hidden;
      border-radius: var(--radius-small);
      background-color: var(--surface-placeholder);
    }
    .sheep__frame img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1036 / 717;
      object-fit: cover;
    }
    .sheep__badge {
      padding-top: var(--space-1);
    }
    .sheep__plan {
      font-family: var(--font-pixel);
      font-size: var(--h5);
      letter-spacing: var(--tracking-pixel);
      color: var(--text);
    }
    .sheep__name {
      font-family: var(--primary-family);
      font-weight: var(--primary-regular);
      font-size: var(--h3);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sheep__body {
      font-family: var(--primary-family);
      font-weight: var(--primary-regular);
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--text);
      text-wrap: pretty;
    }
  }
</style>
