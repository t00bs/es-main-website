---
// Home work section: three pixel-label tabs, the rule segment slides to the
// active tab, and each tab reveals its own 3-card grid with a crossfade.
// A case study appears under every tab listed in its `tags` field. The JSON
// collection is imported directly so visual editors can bind the loops to it.
//
// Built on the Lumos Tabs component, which supplies the tablist roles, arrow-key
// navigation and panel cross-fade. The sliding rule underneath is ours, and is
// driven entirely by :has() off the active tab — no extra script.
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Tabs from "@/components/Interactive/Tabs.astro";
import TabLink from "@/components/Interactive/TabLink.astro";
import WorkCard from "./WorkCard.astro";
import caseStudies from "../../data/case-studies.json";

const sorted = [...caseStudies].sort((a, b) => a.order - b.order);
const designWork = sorted
  .filter((item) => item.tags.includes("design"))
  .slice(0, 3);
const automationWork = sorted
  .filter((item) => item.tags.includes("automation"))
  .slice(0, 3);
const portalsWork = sorted
  .filter((item) => item.tags.includes("portals"))
  .slice(0, 3);
---

<Section paddingBottom="none">
  <Tabs id="work" class="work-tabs width-full">
    <Fragment slot="links">
      <TabLink>DESIGN</TabLink>
      <TabLink>AUTOMATION</TabLink>
      <TabLink>PORTALS</TabLink>
    </Fragment>

    <Grid
      xsmall={1}
      large={3}
      class="hover-zoom tab-grid width-full reveal-group"
    >
      {
        designWork.map((item) => (
          <WorkCard
            src={item.cardImage}
            title={item.title}
            subtitle={item.subtitle}
            showArrow
            href={`/work/${item.id}`}
            eager
          />
        ))
      }
    </Grid>

    <Grid
      xsmall={1}
      large={3}
      class="hover-zoom tab-grid width-full reveal-group"
    >
      {
        automationWork.map((item) => (
          <WorkCard
            src={item.cardImage}
            title={item.title}
            subtitle={item.subtitle}
            showArrow
            href={`/work/${item.id}`}
          />
        ))
      }
    </Grid>

    <Grid
      xsmall={1}
      large={3}
      class="hover-zoom tab-grid width-full reveal-group"
    >
      {
        portalsWork.map((item) => (
          <WorkCard
            src={item.cardImage}
            title={item.title}
            subtitle={item.subtitle}
            showArrow
            href={`/work/${item.id}`}
          />
        ))
      }
    </Grid>
  </Tabs>
</Section>

<style is:global>
  @layer components {
    /* The bar carries both rules: a full-width hairline, and the heavy segment
       that slides between the three tab positions. */
    .work-tabs .tabs_bar {
      position: relative;
      padding-bottom: var(--rule-thick);
      border: 0;
      overflow: visible;

      &::before,
      &::after {
        content: "";
        position: absolute;
        bottom: 0;
      }
      &::before {
        left: 0;
        right: 0;
        height: var(--rule-thin);
        background: var(--rule-hairline);
      }
      &::after {
        left: 0;
        width: 4.8125rem;
        height: var(--rule-thick);
        background: var(--rule-strong);
        transition:
          left 0.35s cubic-bezier(0.2, 0.6, 0.2, 1),
          transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1);
      }
    }

    /* Three tabs, three stops. Reading the active tab with :has() keeps the
       segment in sync without a resize observer or a click handler. */
    .work-tabs .tabs_bar:has(.tabs_link:nth-child(2).is-active)::after {
      left: 50%;
      transform: translateX(-50%);
    }
    .work-tabs .tabs_bar:has(.tabs_link:nth-child(3).is-active)::after {
      left: 100%;
      transform: translateX(-100%);
    }

    .work-tabs .tabs_links {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-1) 0;
      overflow: visible;
    }

    .work-tabs .tabs_link {
      appearance: none;
      background: none;
      border: 0;
      border-radius: 0;
      padding: 0;
      min-height: 0;
      /* Lumos lets tabs grow to share the bar; these shrink to their text so
         space-between throws the three labels to the edges and the middle. */
      flex: 0 0 auto;
      cursor: pointer;
      font-family: var(--font-pixel);
      font-weight: var(--primary-regular);
      font-size: var(--h5);
      line-height: var(--line-height-small);
      letter-spacing: var(--tracking-pixel);
      white-space: nowrap;
      color: var(--text);
      opacity: 0.35;
      transition: opacity 0.25s ease;

      &.is-active {
        opacity: 1;
      }
      &:not(.is-active):hover {
        opacity: 0.7;
      }
    }

    .work-tabs .tabs_panels {
      padding-top: var(--space-5);
    }

    @media (prefers-reduced-motion: reduce) {
      .work-tabs .tabs_bar::after {
        transition: none;
      }
    }
  }
</style>
