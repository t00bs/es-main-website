---
// Square work-grid tile: image, protection gradient, title (+ optional subtitle & arrow).
// The title is visually hidden — the client's name or logo is in the image —
// but stays in the markup as the link's text for search engines and screen
// readers. The subtitle and arrow always show; on hover only the image moves,
// zoomed by `.hover-zoom` on an ancestor.
// Optional `tags` render as outline pills top-left, matching the case-study page.
// `portrait` makes it a 9:16 tile, for the carousels and the work grid.
import PillBadge from "./PillBadge.astro";

interface Props {
  src?: string;
  title: string;
  subtitle?: string;
  showArrow?: boolean;
  href?: string;
  tags?: string[];
  /** Load the image immediately instead of lazily — for cards near the fold. */
  eager?: boolean;
  /** 9:16 portrait tile instead of a square, with a smaller title. */
  portrait?: boolean;
}

const {
  src,
  title,
  subtitle,
  showArrow = false,
  href = "#",
  tags = [],
  eager = false,
  portrait = false,
} = Astro.props;

const ARROW_PATH =
  "M 27 19.286 L 23.143 19.286 L 23.143 3.857 L 7.714 3.857 L 7.714 0 L 27 0 L 27 19.286 Z M 0 27 L 0 23.143 L 3.857 23.143 L 3.857 27 L 0 27 Z M 3.857 23.143 L 3.857 19.286 L 7.714 19.286 L 7.714 23.143 L 3.857 23.143 Z M 7.714 19.286 L 7.714 15.429 L 11.571 15.429 L 11.571 19.286 L 7.714 19.286 Z M 11.571 15.429 L 11.571 11.571 L 15.429 11.571 L 15.429 15.429 L 11.571 15.429 Z M 15.429 11.571 L 15.429 7.714 L 19.286 7.714 L 19.286 11.571 L 15.429 11.571 Z";
---

<a href={href} class:list={["work-card", portrait && "work-card--portrait"]}>
  {
    src && (
      <img
        src={src}
        alt=""
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
    )
  }
  <div class="work-card__overlay"></div>
  {tags.length > 0 && <div class="work-card__tags-protect" />}
  {
    tags.length > 0 && (
      <div class="work-card__tags">
        {tags.map((tag) => (
          <PillBadge>{tag}</PillBadge>
        ))}
      </div>
    )
  }
  <div class="work-card__caption" style={`bottom: ${subtitle ? 16 : 11}px;`}>
    <div class="work-card__text">
      <span class="work-card__title sr-only">{title}</span>
      {subtitle && <span class="work-card__subtitle">{subtitle}</span>}
    </div>
    {
      showArrow && (
        <svg
          class="work-card__arrow"
          width="27"
          height="27"
          viewBox="0 0 27 27"
          fill="var(--text-on-image)"
          aria-hidden="true"
        >
          <path d={ARROW_PATH} fill-rule="nonzero" />
        </svg>
      )
    }
  </div>
</a>

<style>
  @layer components {
    .work-card {
      position: relative;
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: var(--radius-small);
      background-color: var(--surface-placeholder);
      text-decoration: none;
    }
    .work-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .work-card__overlay {
      position: absolute;
      inset: 0;
      background: var(--overlay-protect);
    }
    /* Top counterpart of the bottom protection gradient so the tag pills stay
     legible on light imagery. */
    .work-card__tags-protect {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0) 45%
      );
    }
    .work-card__tags {
      position: absolute;
      left: var(--card-pad);
      right: var(--card-pad);
      top: 22px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    /* Pills a size down from the page's, so service names fit across a
       narrow portrait card. Padding keeps the pill's optical centring, scaled
       with the type. One too long for the card ends in an ellipsis rather
       than running off the edge — inline-block, because a flex box can't
       take one. */
    .work-card__tags :global(.pill-badge) {
      display: inline-block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: var(--text-small);
      padding: 9px 10px 7px;
    }
    .work-card__caption {
      position: absolute;
      left: var(--card-pad);
      right: var(--card-pad);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .work-card__text {
      display: flex;
      flex-direction: column;
    }
    .work-card__title {
      font-family: var(--primary-family);
      font-weight: 400;
      font-size: var(--h3);
      line-height: var(--line-height-medium);
      white-space: nowrap;
      color: var(--text-on-image);
    }
    .work-card__subtitle {
      font-family: var(--primary-family);
      font-weight: 400;
      font-size: var(--text-small);
      line-height: var(--line-height-medium);
      white-space: nowrap;
      color: var(--text-on-image);
    }
    .work-card svg {
      flex-shrink: 0;
    }

    /* Portrait tiles are narrow, so the caption wraps rather than running
     under the arrow. */
    .work-card--portrait {
      aspect-ratio: 9 / 16;
    }
    .work-card--portrait .work-card__caption {
      gap: var(--space-3);
    }
    .work-card--portrait .work-card__title {
      font-size: var(--h5);
      white-space: normal;
    }
    .work-card--portrait .work-card__subtitle {
      white-space: normal;
    }
  }
</style>
