---
// Outline pill badge (40px radius, 1px inset stroke) — e.g. "Customer Stories".
interface Props {
  color?: string;
}

const { color = "var(--text-on-image)" } = Astro.props;
---

<span
  class="pill-badge"
  style={`color: ${color}; box-shadow: inset 0 0 0 1px ${color};`}
>
  <slot />
</span>

<style>
  @layer components {
    .pill-badge {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 11px 12px 8px 12px;
      border-radius: var(--radius-round);
      font-family: var(--primary-family);
      font-weight: 400;
      font-size: var(--text-main);
      line-height: var(--line-height-small);
      white-space: nowrap;
    }
  }
</style>
