---
// The Sheepdog demo: a scripted Slack workspace for a made-up client (Kestrel
// Quay) that plays four requests through to a published, undoable change.
// Ported from the standalone demo (products/agentic-cms/demo). The Slack
// window imitates Slack, so it keeps Slack's own colours and type; the chrome
// around it (scenario tabs, controls, caption) is set in the site's tokens.
// Markup inside the window is built by the script, so styles are global and
// scoped under `.sd-demo`. `?demo=2` opens scenario 2; add `&end=1` to jump
// to its end.
---

<div class="sd-demo" id="sd-stage" aria-label="Sheepdog demo" role="region">
  <div class="tabs" role="tablist" id="sd-tabs"></div>
  <div class="stage-grid">
    <div>
      <div class="slack" id="sd-slack">
        <aside class="side" aria-hidden="true">
          <div class="ws"><span class="ws-ico">KQ</span>Kestrel Quay</div>
          <h4>Channels</h4>
          <div class="ch"># general</div>
          <div class="ch"># events</div>
          <div class="ch"># marketing</div>
          <div class="ch on"># website</div>
          <h4>Direct messages</h4>
          <div class="ch"><span class="dot"></span>Maya Patel</div>
          <div class="ch"><span class="dot"></span>Tom Ferris</div>
          <div class="ch">
            <span class="dot"></span>Toby Balderson <span class="ext">ext</span>
          </div>
          <h4>Apps</h4>
          <div class="ch"><span class="dot"></span>Sheepdog</div>
        </aside>
        <div class="chan">
          <div class="ph"><b># website</b><small>6 members</small></div>
          <div class="feed" id="sd-feed"></div>
          <div class="composer">Message #website</div>
        </div>
        <div class="thread">
          <div class="ph">
            <span
              ><span class="back">‹ # website&nbsp;&nbsp;</span><b>Thread</b
              ></span
            ><small id="sd-tmeta"># website</small>
          </div>
          <div class="tbody" id="sd-tbody" aria-live="polite"></div>
          <div class="composer">Reply…</div>
        </div>
      </div>
      <div class="controls" aria-label="Demo controls">
        <button class="cbtn" id="sd-restart" type="button" aria-label="Restart"
          ><svg viewBox="0 0 16 16"
            ><path
              d="M8 2a6 6 0 1 1-5.7 4.1l1.9.6A4 4 0 1 0 8 4v2.5L4.5 3.3 8 0z"
            ></path></svg
          ></button
        >
        <button
          class="cbtn"
          id="sd-prev"
          type="button"
          aria-label="Back one step"
          ><svg viewBox="0 0 16 16"><path d="M11 2L4 8l7 6z"></path></svg
          ></button
        >
        <button class="cbtn primary" id="sd-play" type="button"
          ><svg viewBox="0 0 16 16" id="sd-playico"
            ><path d="M4 2l10 6-10 6z"></path></svg
          ><span id="sd-playlbl">Play</span></button
        >
        <button class="cbtn" id="sd-next" type="button" aria-label="Next step"
          ><svg viewBox="0 0 16 16"><path d="M5 2l7 6-7 6z"></path></svg
          ></button
        >
        <div class="progress">
          <div class="bar"><i id="sd-barfill"></i></div><span
            class="pixel"
            id="sd-ptext">Step 0 of 0</span>
        </div>
      </div>
    </div>
    <aside class="caption" id="sd-caption" aria-live="polite"></aside>
  </div>
  <p class="sd-demo__fine">
    Kestrel Quay is a made-up club. Everything in this window is scripted, so
    the preview links and results are examples.
  </p>
</div>

<style is:global>
  @layer components {
    .sd-demo {
      /* Chrome in site tokens */
      --ink: var(--text);
      --cream: var(--background);
      --ink-2: color-mix(in lab, var(--text) 85%, var(--background));
      --muted: color-mix(in lab, var(--text) 65%, var(--background));
      --line: var(--rule-hairline);
      --cream-2: color-mix(in lab, var(--text) 8%, var(--background));
      --cream-3: var(--surface-placeholder);
      --pixel: var(--font-pixel);
      /* The Slack window and its mock site */
      --ui:
        -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
        sans-serif;
      --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      --s-side: #1c1d21;
      --s-side-2: #2a2b31;
      --s-side-text: #c9c9cf;
      --s-bg: #fff;
      --s-text: #1d1c1d;
      --s-muted: #616061;
      --s-line: #e6e6e6;
      --s-link: #1264a3;
      --s-hover: #f6f6f6;
      --r-content: #2f7d6d;
      --r-design: #c0602a;
      --r-tracking: #7a4a7f;
      --r-qa: #d9a521;
      --r-seo: #d98a9b;
      --r-publish: #101010;
      --ok: #2e7d32;
      --warn: #b26a00;
      --flag: #8a4f00;
      --k-navy: #13324b;
      --k-sand: #efe6d6;
      --k-sea: #8cc7b5;
      --photo-day:
        radial-gradient(
          ellipse 30% 18% at 70% 30%,
          rgba(255, 250, 230, 0.9),
          transparent 70%
        ),
        linear-gradient(
          180deg,
          #cfe0e4 0%,
          #a9c8d2 48%,
          #3d6f86 49%,
          #2b5468 100%
        );
      --photo:
        radial-gradient(
          ellipse 60% 30% at 50% 58%,
          rgba(255, 196, 120, 0.55),
          transparent 70%
        ),
        linear-gradient(
          180deg,
          #1f2a36 0%,
          #2c3846 38%,
          #3a2c22 52%,
          #6b4a30 53%,
          #4a3020 100%
        );
      width: 100%;
      font-family: var(--primary-family);
      color: var(--text);
    }
    /* Lumos trims every p and heading to its cap height. The Slack replica
       is set like Slack, so switch the trim off inside the window. */
    .sd-demo .slack :is(p, h1, h2, h3, h4, h5, h6) {
      display: block;
      margin: 0;
    }
    .sd-demo .slack :is(p, h1, h2, h3, h4, h5, h6)::before,
    .sd-demo .slack :is(p, h1, h2, h3, h4, h5, h6)::after {
      content: none;
    }
    .sd-demo .slack img {
      width: auto;
    }
    .sd-demo .slack .av img {
      width: 100%;
    }

    .sd-demo .pixel {
      font-family: var(--font-pixel);
      letter-spacing: var(--tracking-pixel);
      text-transform: uppercase;
    }

    /* Scenario tabs */
    .sd-demo .tabs {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }
    .sd-demo .tab {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      min-height: 3.5rem;
      padding: var(--space-3) var(--space-3);
      border: var(--rule-thin) solid var(--rule-hairline);
      border-radius: var(--radius-small);
      color: var(--text);
      text-align: start;
      transition: background-color var(--hover-duration) var(--hover-ease);
    }
    .sd-demo .tab .pixel {
      font-size: var(--text-small);
      color: var(--muted);
    }
    .sd-demo .tab span:last-child {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
    }
    .sd-demo .tab:hover {
      background-color: var(--cream-2);
    }
    .sd-demo .tab[aria-selected="true"] {
      background-color: var(--highlight-block);
      border-color: var(--highlight-block);
      color: var(--highlight-text);
    }
    .sd-demo .tab[aria-selected="true"] .pixel {
      color: color-mix(
        in lab,
        var(--highlight-text) 70%,
        var(--highlight-block)
      );
    }

    .sd-demo .stage-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 16.25rem;
      gap: var(--space-5);
      align-items: start;
    }

    /* Caption beside the window */
    .sd-demo .caption {
      position: sticky;
      top: var(--space-5); /* the nav scrolls away, so no offset */
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .sd-demo .caption .pixel {
      font-size: var(--text-small);
      color: var(--muted);
    }
    .sd-demo .caption .ct {
      font-size: var(--h4);
      line-height: var(--line-height-medium);
      color: var(--text);
    }
    .sd-demo .caption p {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: var(--ink-2);
    }
    .sd-demo .caption .who {
      border-top: var(--rule-thin) solid var(--rule-hairline);
      padding-top: var(--space-3);
      font-size: var(--text-small);
      line-height: var(--line-height-large);
      color: var(--muted);
    }
    .sd-demo .caption .who strong {
      font-weight: inherit;
      color: var(--text);
    }

    /* Controls under the window */
    .sd-demo .controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }
    .sd-demo .cbtn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      min-width: 3rem;
      height: 3rem;
      padding: 0 var(--space-4);
      border: var(--rule-thin) solid var(--text);
      border-radius: var(--radius-round);
      color: var(--text);
      font-size: var(--text-main);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }
    .sd-demo .cbtn:hover {
      background-color: var(--cream-2);
    }
    .sd-demo .cbtn.primary {
      min-width: 7.5rem;
      background-color: var(--button-background);
      border-color: var(--button-border);
      color: var(--button-text);
    }
    .sd-demo .cbtn.primary:hover {
      background-color: var(--button-background-hover);
      color: var(--button-text-hover);
    }
    .sd-demo .cbtn svg {
      width: 0.875rem;
      height: 0.875rem;
      fill: currentColor;
    }
    .sd-demo .progress {
      flex: 1;
      min-width: 11.25rem;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-left: var(--space-2);
    }
    .sd-demo .bar {
      height: 0.25rem;
      overflow: hidden;
      border-radius: var(--radius-round);
      background-color: var(--cream-3);
    }
    .sd-demo .bar i {
      display: block;
      width: 0;
      height: 100%;
      background-color: var(--text);
      transition: width 0.4s;
    }
    .sd-demo .progress .pixel {
      font-size: var(--text-small);
      color: var(--muted);
    }
    .sd-demo__fine {
      margin-top: var(--space-4);
      font-size: var(--text-small);
      line-height: var(--line-height-large);
      color: var(--muted);
    }

    @media (width < 73.75rem) {
      .sd-demo .stage-grid {
        grid-template-columns: 1fr;
      }
      .sd-demo .caption {
        position: static;
        order: -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3) var(--space-6);
      }
      .sd-demo .caption .who {
        grid-column: 2;
        grid-row: 1 / span 3;
        border-top: 0;
        padding-top: 0;
      }
    }
    @media (width < 45rem) {
      .sd-demo .tabs {
        grid-template-columns: 1fr 1fr;
      }
      .sd-demo .caption {
        display: flex;
      }
      .sd-demo .caption .who {
        border-top: var(--rule-thin) solid var(--rule-hairline);
        padding-top: var(--space-3);
      }
      .sd-demo .controls {
        gap: var(--space-2);
      }
      .sd-demo .cbtn {
        padding: 0 var(--space-3);
      }
      .sd-demo .progress {
        order: 5;
        min-width: 100%;
        margin: var(--space-2) 0 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .sd-demo * {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
      }
    }

    /* --- Slack window (from the standalone demo) --- */
    .sd-demo .slack {
      background: var(--s-bg);
      color: var(--s-text);
      font-family: var(--ui);
      font-size: 15px;
      line-height: 1.42;
      border-radius: 12px;
      overflow: hidden;
      box-shadow:
        0 1px 0 rgba(0, 0, 0, 0.04),
        0 24px 60px -24px rgba(16, 16, 16, 0.35);
      border: 1px solid rgba(16, 16, 16, 0.18);
      display: grid;
      grid-template-columns: 180px minmax(210px, 0.62fr) minmax(0, 1.4fr);
      grid-template-rows: minmax(0, 1fr);
      height: 680px;
    }
    .sd-demo .side {
      background: var(--s-side);
      color: var(--s-side-text);
      padding: 12px 8px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 14px;
      overflow: hidden;
    }
    .sd-demo .ws {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #fff;
      font-weight: 700;
      padding: 4px 8px 12px;
      border-bottom: 1px solid #34353b;
      margin-bottom: 8px;
    }
    .sd-demo .ws-ico {
      width: 26px;
      height: 26px;
      border-radius: 6px;
      background: var(--k-sea);
      color: var(--k-navy);
      display: grid;
      place-items: center;
      font-size: 12px;
      font-weight: 800;
    }
    .sd-demo .side h4 {
      margin: 12px 8px 4px;
      font-size: 12px;
      font-weight: 600;
      color: #8e8e96;
    }
    .sd-demo .ch {
      padding: 4px 8px;
      border-radius: 6px;
      display: flex;
      gap: 6px;
      align-items: center;
      white-space: nowrap;
    }
    .sd-demo .ch.on {
      background: #3d5a6c;
      color: #fff;
    }
    .sd-demo .ch .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #3aa76d;
    }
    .sd-demo .ch .ext {
      font-size: 10px;
      border: 1px solid #5a5b62;
      border-radius: 4px;
      padding: 0 4px;
      color: #a9a9b1;
    }
    .sd-demo .chan {
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--s-line);
      min-width: 0;
      min-height: 0;
    }
    .sd-demo .ph {
      height: 52px;
      border-bottom: 1px solid var(--s-line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      gap: 8px;
      flex-shrink: 0;
    }
    .sd-demo .ph b {
      font-size: 16px;
    }
    .sd-demo .ph small {
      color: var(--s-muted);
      font-size: 13px;
      white-space: nowrap;
    }
    .sd-demo .ph .back {
      display: none;
    }
    .sd-demo .feed {
      flex: 1;
      overflow-y: auto;
      padding: 8px 0;
    }
    .sd-demo .composer {
      margin: 0 12px 12px;
      border: 1px solid #c9c9c9;
      border-radius: 8px;
      padding: 10px 12px;
      color: #8c8c8c;
      font-size: 14px;
      flex-shrink: 0;
    }
    .sd-demo .thread {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 0;
      background: #fff;
    }
    .sd-demo .tbody {
      flex: 1;
      overflow-y: auto;
      padding: 8px 0 16px;
      scroll-behavior: smooth;
    }
    .sd-demo .divider {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--s-muted);
      font-size: 13px;
      padding: 6px 16px;
    }
    .sd-demo .divider:after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--s-line);
    }
    .sd-demo .m {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 10px;
      padding: 8px 16px;
      animation: sd-pop 0.35s ease-out;
    }
    .sd-demo .m:hover {
      background: var(--s-hover);
    }
    .sd-demo .feed .m {
      cursor: pointer;
      animation: none;
    }
    .sd-demo .feed .m.on {
      background: #f2f7fb;
      box-shadow: inset 3px 0 0 #1264a3;
    }
    @keyframes sd-pop {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .sd-demo .av {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      flex-shrink: 0;
    }
    .sd-demo .av.bot {
      font-family: var(--pixel);
      font-weight: 400;
      letter-spacing: 0.05em;
      font-size: 14px;
    }
    .sd-demo .av.img {
      padding: 2px;
      overflow: hidden;
    }
    .sd-demo .av.img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 6px;
    }
    .sd-demo .mh {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px;
      line-height: 1.2;
      margin-bottom: 2px;
    }
    .sd-demo .mh b {
      font-weight: 800;
    }
    .sd-demo .mh .role {
      font-weight: 700;
      color: var(--s-muted);
    }
    .sd-demo .mh .app {
      font-size: 10px;
      font-weight: 700;
      background: #ececec;
      color: #555;
      border-radius: 3px;
      padding: 1px 4px;
      letter-spacing: 0.02em;
    }
    .sd-demo .mh .ext {
      font-size: 10px;
      font-weight: 700;
      border: 1px solid #c7c7c7;
      color: #555;
      border-radius: 3px;
      padding: 0 4px;
    }
    .sd-demo .mh time {
      color: var(--s-muted);
      font-size: 12px;
    }
    .sd-demo .mt p {
      margin: 0 0 6px;
    }
    .sd-demo .mt p:last-child {
      margin-bottom: 0;
    }
    .sd-demo .mt ul {
      margin: 2px 0 8px;
      padding-left: 20px;
    }
    .sd-demo .mt li {
      margin: 2px 0;
    }
    .sd-demo .mt .lbl {
      font-weight: 700;
      margin: 8px 0 2px;
    }
    .sd-demo .mt a {
      color: var(--s-link);
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    .sd-demo .mt a:hover {
      text-decoration: underline;
    }
    .sd-demo .mt code,
    .sd-demo .draft {
      font-family: var(--mono);
      font-size: 12.5px;
      background: #f3f3f3;
      border: 1px solid #e4e4e4;
      border-radius: 4px;
      padding: 1px 5px;
      color: #c0315a;
      word-break: break-all;
    }
    .sd-demo .draft {
      display: inline-block;
      white-space: nowrap;
      word-break: normal;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      vertical-align: bottom;
    }
    .sd-demo .confirm {
      background: #fff4d6;
      border: 1px solid #f0d58a;
      border-radius: 4px;
      padding: 0 4px;
      font-size: 13px;
      white-space: nowrap;
    }
    .sd-demo .feed .mt {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .sd-demo .replies {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      margin-top: 4px;
      color: var(--s-link);
      font-size: 13px;
      font-weight: 700;
    }
    .sd-demo .replies i {
      width: 18px;
      height: 18px;
      border-radius: 4px;
      display: inline-block;
    }
    .sd-demo .typing {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 16px;
      color: var(--s-muted);
      font-size: 13px;
    }
    .sd-demo .typing span {
      display: inline-flex;
      gap: 3px;
    }
    .sd-demo .typing span i {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #9a9a9a;
      animation: sd-blink 1s infinite;
    }
    .sd-demo .typing span i:nth-child(2) {
      animation-delay: 0.15s;
    }
    .sd-demo .typing span i:nth-child(3) {
      animation-delay: 0.3s;
    }
    @keyframes sd-blink {
      0%,
      100% {
        opacity: 0.25;
      }
      50% {
        opacity: 1;
      }
    }
    .sd-demo .unfurl {
      border-left: 4px solid #dcdcdc;
      padding: 2px 0 2px 12px;
      margin: 6px 0;
      font-size: 14px;
    }
    .sd-demo .unfurl .src {
      font-weight: 700;
      font-size: 13px;
    }
    .sd-demo .unfurl .src em {
      font-style: normal;
      color: #0a66c2;
    }
    .sd-demo .file {
      display: inline-flex;
      flex-direction: column;
      border: 1px solid var(--s-line);
      border-radius: 8px;
      overflow: hidden;
      margin-top: 6px;
      width: 200px;
      max-width: 100%;
    }
    .sd-demo .file .ph-img {
      height: 110px;
      background: var(--photo);
    }
    .sd-demo .file small {
      padding: 6px 10px;
      color: var(--s-muted);
      font-size: 12px;
    }
    .sd-demo .card {
      border: 1px solid var(--s-line);
      border-radius: 8px;
      margin: 8px 0;
      overflow: hidden;
      background: #fff;
    }
    .sd-demo .card-h {
      padding: 10px 12px;
      border-bottom: 1px solid var(--s-line);
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .sd-demo .card-h b {
