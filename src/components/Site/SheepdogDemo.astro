      },
      {
        key: "live",
        tab: "Approve and go live",
        title: "Checked, approved, live, and undoable",
        caption:
          "Back in Monday\u2019s thread. The preview has been tested before anyone looks at it. One press and it\u2019s live in under a minute, with Undo on the message for seven days and a record of who asked and who approved.",
        who: "<strong>Maya</strong> publishes it herself. Toby gets a note and sees every change in the daily digest.",
        thread: "a",
        day: "Monday 2 November",
        earlier: 3,
        parent: null,
        steps: [
          {
            who: "maya",
            time: "09:26",
            wait: 1800,
            html: "<p>Looks great. Credit the photo to Kestrel Quay, it\u2019s one of ours.</p>",
          },
          {
            who: "content",
            time: "09:27",
            wait: 2600,
            html:
              "<p>Credit added under the photo. Same preview link, updated: " +
              link("1102-winter-supper-club") +
              "</p>" +
              shots("news2", "1102-winter-supper-club") +
              '<div class="qa-row"><span class="ic ok" aria-hidden="true">✓</span><span>Checks ran again: 15 of 15 passed.</span></div><div class="card"><div class="card-b"><b>Ready to go live</b><p style="margin:4px 0 0">Content changes like this one are yours to publish. Toby gets a note, and Undo stays on the message for 7 days.</p><div class="btns"><button class="sbtn go" data-act="approve" type="button">Approve to go live</button><button class="sbtn" data-act="fake" type="button">Request changes</button><button class="sbtn" data-act="fake" type="button">Discard</button></div></div></div>',
          },
          {
            who: "publish",
            time: "09:31",
            wait: 2600,
            trigger: "approve",
            html: "<p><b>Maya Patel</b> pressed Approve to go live.</p>",
          },
          {
            who: "publish",
            time: "09:32",
            wait: 3000,
            html:
              '<p>Live: <a href="#" data-act="fake">kestrelquay.je/news/winter-supper-club</a>. Published in 42 seconds.</p>' +
              shots("live", "", true) +
              '<span class="pill live"><i></i>Live</span><div class="btns"><button class="sbtn" data-act="undo" type="button">Undo</button></div><p class="hint">Undo is here for 7 days. It puts back the previous version of every page this change touched.</p><div class="log">Logged: asked by Maya Patel, published by Maya Patel, 2 Nov 09:31.</div>',
          },
        ],
      },
    ];
    var UNDO = {
      who: "publish",
      time: "09:34",
      html: "<p>Undone. The site is back to how it was at 09:31. The draft is kept, so you can publish it again from this thread.</p>",
    };

    var PACE = 1.75,
      cur = 0,
      pos = 0,
      playing = false,
      timer = null,
      undone = false,
      maxSeen = 0;
    var $ = function (id) {
      return document.getElementById(id);
    };
    var tbody = $("sd-tbody"),
      feed = $("sd-feed");

    function msg(m, cls, extra, attrs) {
      var p = PEOPLE[m.who],
        nm = p.bot ? "Sheepdog" : p.name;
      var head =
        "<b>" +
        nm +
        "</b>" +
        (p.bot
          ? '<span class="role">' +
            p.role +
            '</span><span class="app">APP</span>'
          : "") +
        (p.ext ? '<span class="ext">' + p.ext + "</span>" : "") +
        "<time>" +
        m.time +
        "</time>";
      var av = p.img
        ? '<img src="' + p.img + '" alt="" width="36" height="36">'
        : p.init;
      return (
        "<div " +
        (attrs || "") +
        ' class="m' +
        (cls ? " " + cls : "") +
        '"><div class="av' +
        (p.bot ? " bot" : "") +
        (p.img ? " img" : "") +
        '" style="background:' +
        p.col +
        '" aria-hidden="true">' +
        av +
        '</div><div class="mb"><div class="mh">' +
        head +
        '</div><div class="mt">' +
        m.html +
        "</div>" +
        (extra || "") +
        "</div></div>"
      );
    }
    function parentOf(i) {
      return S[i].parent || S[0].parent;
    }
    function totalSteps() {
      return S.reduce(function (a, s) {
        return a + s.steps.length;
      }, 0);
    }
    function doneSteps() {
      var n = 0;
      for (var i = 0; i < cur; i++) n += S[i].steps.length;
      return n + pos;
    }

    function renderTabs() {
      $("sd-tabs").innerHTML = S.map(function (s, i) {
        return (
          '<button class="tab" role="tab" type="button" aria-selected="' +
          (i === cur) +
          '" data-i="' +
          i +
          '"><span class="pixel">0' +
          (i + 1) +
          " · " +
          s.tab +
          "</span><span>" +
          s.title +
          "</span></button>"
        );
      }).join("");
    }
    function renderFeed() {
      var parents = [0, 1, 2],
        html = "";
      parents.forEach(function (i) {
        if (i > Math.max(maxSeen, cur)) return;
        var s = S[i],
          n = s.steps.length;
        if (i === 0) {
          n =
            maxSeen >= 3
              ? S[0].steps.length + (cur === 3 ? pos : S[3].steps.length)
              : cur === 0
                ? pos
                : n;
        } else if (i === cur) {
          n = pos;
        }
        var active = S[cur].thread === s.thread;
        var rep = n
          ? '<div class="replies"><i style="background:var(--r-' +
            s.key +
            ')"></i>' +
            n +
            (n === 1 ? " reply" : " replies") +
            "</div>"
          : "";
        html +=
          '<div class="divider">' +
          s.day +
          "</div>" +
          msg(
            s.parent,
            active ? "on" : "",
            rep,
            'data-i="' + (i === 0 && cur === 3 ? 3 : i) + '"',
          );
      });
      feed.innerHTML = html;
    }
    function render(scroll) {
      var s = S[cur],
        html = '<div class="divider">' + s.day + "</div>" + msg(parentOf(cur));
      if (s.earlier) {
        html += '<div class="divider">' + s.earlier + " earlier replies</div>";
      } else
        html += '<div class="divider">' + s.steps.length + " replies</div>";
      for (var i = 0; i < pos; i++) html += msg(s.steps[i]);
      if (cur === 3 && undone && pos === s.steps.length) html += msg(UNDO);
      tbody.innerHTML = html;
      /* pressed states */
      tbody.querySelectorAll("[data-act]").forEach(function (b) {
        var a = b.getAttribute("data-act");
        if (a === "undo" && undone) {
          b.classList.add("done");
          b.disabled = true;
        }
        for (var k = 0; k < pos; k++) {
          if (s.steps[k].trigger === a) {
            b.classList.add("done");
            b.disabled = true;
          }
        }
      });
      $("sd-caption").innerHTML =
        '<span class="pixel">Scenario ' +
        (cur + 1) +
        " of " +
        S.length +
        '</span><p class="ct">' +
        s.title +
        "</p><p>" +
        s.caption +
        '</p><div class="who">' +
        s.who +
        "</div>";
      $("sd-tmeta").textContent = "# website";
      renderTabs();
      renderFeed();
      var t = totalSteps(),
        d = doneSteps();
      $("sd-barfill").style.width = (100 * d) / t + "%";
      $("sd-ptext").textContent =
        "Scenario " +
        (cur + 1) +
        " of " +
        S.length +
        " · step " +
        pos +
        " of " +
        s.steps.length;
      if (scroll !== false)
        requestAnimationFrame(function () {
          tbody.scrollTop = tbody.scrollHeight;
        });
    }
    function setPlaying(p) {
      playing = p;
      $("sd-playlbl").textContent = p ? "Pause" : atEnd() ? "Replay" : "Play";
      $("sd-playico").innerHTML = p
        ? '<path d="M3 2h4v12H3zM9 2h4v12H9z"/>'
        : '<path d="M4 2l10 6-10 6z"/>';
      clearTimeout(timer);
      var ty = tbody.querySelector(".typing");
      if (ty) ty.remove();
      if (p) schedule();
    }
    function atEnd() {
      return cur === S.length - 1 && pos === S[cur].steps.length;
    }
    function showTyping(who) {
      var p = PEOPLE[who];
      var el = document.createElement("div");
      el.className = "typing";
      el.innerHTML =
        "<span><i></i><i></i><i></i></span>" +
        (p.bot ? "Sheepdog " + p.role + " is working" : p.name + " is typing");
      tbody.appendChild(el);
      tbody.scrollTop = tbody.scrollHeight;
    }
    function schedule() {
      clearTimeout(timer);
      var s = S[cur];
      if (pos >= s.steps.length) {
        if (cur < S.length - 1) {
          timer = setTimeout(function () {
            go(cur + 1, 0);
            if (playing) schedule();
          }, 3800);
        } else setPlaying(false);
        return;
      }
      var st = s.steps[pos],
        W = Math.round(st.wait * PACE);
      if (st.trigger) {
        timer = setTimeout(function () {
          var b = tbody.querySelector('[data-act="' + st.trigger + '"]');
          if (b) {
            b.classList.add("press");
          }
          timer = setTimeout(function () {
            showTyping(st.who);
            timer = setTimeout(function () {
              step(1);
            }, 900);
          }, 700);
        }, W);
        return;
      }
      timer = setTimeout(
        function () {
          showTyping(st.who);
          timer = setTimeout(
            function () {
              step(1);
            },
            PEOPLE[st.who].bot ? 1600 : 1000,
          );
        },
        PEOPLE[st.who].bot ? Math.max(500, W - 1600) : W,
      );
    }
    function go(i, p) {
      fresh = false;
      cur = i;
      pos = p;
      maxSeen = Math.max(maxSeen, i);
      if (i !== 3) undone = false;
      render();
    }
    function step(d) {
      fresh = false;
      var s = S[cur];
      if (d > 0) {
        if (pos < s.steps.length) {
          pos++;
          render();
        } else if (cur < S.length - 1) {
          go(cur + 1, 0);
        }
      } else {
        if (pos > 0) {
          pos--;
          if (cur === 3) undone = false;
          render();
        } else if (cur > 0) {
          go(cur - 1, S[cur - 1].steps.length);
        }
      }
      maxSeen = Math.max(maxSeen, cur);
      if (playing) schedule();
      else setPlaying(false);
    }

    var fresh = true;
    $("sd-play").addEventListener("click", function () {
      if (playing) {
        setPlaying(false);
        return;
      }
      if (atEnd() || fresh) {
        undone = false;
        maxSeen = 0;
        go(0, 0);
      }
      fresh = false;
      setPlaying(true);
    });
    $("sd-next").addEventListener("click", function () {
      setPlaying(false);
      step(1);
    });
    $("sd-prev").addEventListener("click", function () {
      setPlaying(false);
      step(-1);
    });
    $("sd-restart").addEventListener("click", function () {
      undone = false;
      maxSeen = 0;
      go(0, 0);
      setPlaying(true);
    });
    $("sd-watch").addEventListener("click", function () {
      var y =
        $("sd-stage").getBoundingClientRect().top + window.pageYOffset - 12;
      window.scrollTo({
        top: y,
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
      undone = false;
      maxSeen = 0;
      go(0, 0);
      setPlaying(true);
    });
    $("sd-tabs").addEventListener("click", function (e) {
      var t = e.target.closest(".tab");
      if (!t) return;
      var i = +t.getAttribute("data-i");
      undone = false;
      go(i, 0);
      setPlaying(true);
    });
    feed.addEventListener("click", function (e) {
      var m = e.target.closest("[data-i]");
      if (!m) return;
      var i = +m.getAttribute("data-i");
      if (i === cur) return;
      go(i, S[i].steps.length);
      setPlaying(false);
    });
    tbody.addEventListener("click", function (e) {
      var b = e.target.closest("[data-act]");
      if (!b) return;
      e.preventDefault();
      var a = b.getAttribute("data-act"),
        s = S[cur],
        nx = s.steps[pos];
      if (a === "undo") {
        if (!undone) {
          undone = true;
          setPlaying(false);
          render();
        }
        return;
      }
      if (nx && nx.trigger === a) {
        clearTimeout(timer);
        b.classList.add("press");
        step(1);
        return;
      }
      if (a === "fake") {
        b.blur();
      }
    });
    document.addEventListener("keydown", function (e) {
      // Arrow keys step the demo only while focus is inside it, so they still scroll the page elsewhere.
      if (!(e.target.closest && e.target.closest("#sd-stage"))) return;
      if (e.key === "ArrowRight") {
        setPlaying(false);
        step(1);
      } else if (e.key === "ArrowLeft") {
        setPlaying(false);
        step(-1);
      }
    });
    var q = new URLSearchParams(location.search),
      si = parseInt(q.get("demo"), 10);
    if (si >= 1 && si <= S.length) {
      cur = si - 1;
      maxSeen = cur;
      pos = q.get("end") ? S[cur].steps.length : 0;
    } else {
      pos = S[0].steps.length;
    }
    render(false);
    setPlaying(false);
  })();
</script>
