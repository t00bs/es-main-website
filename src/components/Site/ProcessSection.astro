---
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import SectionLabel from "./SectionLabel.astro";
import processSteps from "../../data/process-steps.json";

// "How we work": four numbered steps in ruled columns. The `.step` pattern
// lives in site-patterns.css, shared with the Sheepdog page's "How it works".
---

<Section>
  <SectionLabel highlight="How We Work" />
  <Grid xsmall={1} small={2} large={4} class="width-full reveal-group">
    {
      processSteps.map((item) => (
        <div class="step">
          <span class="step__number">{item.number}</span>
          <span class="step__title">{item.title}</span>
          <span class="step__body">{item.body}</span>
        </div>
      ))
    }
  </Grid>
</Section>
