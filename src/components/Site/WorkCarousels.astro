---
// Home work section: two Netflix-style rows — Design & Automation, Portals —
// of 9:16 work cards, three in view from tablet up (see WorkRow for the row
// itself). A case study appears in every row listed in its `tags` field. The
// JSON collection is imported directly so visual editors can bind the loops
// to it.
import Section from "@/components/Wrapper/Section.astro";
import WorkRow from "./WorkRow.astro";
import WorkCard from "./WorkCard.astro";
import caseStudies from "../../data/case-studies.json";

const sorted = [...caseStudies].sort((a, b) => a.order - b.order);
const designAutomationWork = sorted.filter((item) =>
  item.tags.includes("design-automation"),
);
const portalsWork = sorted.filter((item) => item.tags.includes("portals"));
---

<Section paddingTop="none" paddingBottom="none" gap="7">
  <WorkRow label="Design & Automation" medium={3} large={3}>
    {
      designAutomationWork.map((item, index) => (
        <WorkCard
          src={item.cardImage}
          title={item.title}
          subtitle={item.subtitle}
          showArrow
          href={`/work/${item.id}`}
          portrait
          eager={index < 3}
        />
      ))
    }
  </WorkRow>

  <WorkRow label="Portals" medium={3} large={3}>
    {
      portalsWork.map((item) => (
        <WorkCard
          src={item.cardImage}
          title={item.title}
          subtitle={item.subtitle}
          showArrow
          href={`/work/${item.id}`}
          portrait
        />
      ))
    }
  </WorkRow>
</Section>
