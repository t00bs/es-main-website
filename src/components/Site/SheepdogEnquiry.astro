---
// The "Ask about Sheepdog" modal: an enquiry form posting to ElectricForms,
// protected by reCAPTCHA v3 and Form's spam trap. Opened by any link to
// `#sheepdog-enquiry` or `[data-modal-open="sheepdog-enquiry"]`.
import Modal from "@/components/Interactive/Modal.astro";
import Form from "@/components/Form/Form.astro";
import Input from "@/components/Form/Input.astro";
import Select from "@/components/Form/Select.astro";
import Textarea from "@/components/Form/Textarea.astro";
import Button from "@/components/Button.astro";
import { SHEEPDOG_FORM_ENDPOINT, RECAPTCHA_SITE_KEY } from "@/consts.ts";
---

<Modal id="sheepdog-enquiry" label="Ask about Sheepdog" class="sd-enquiry">
  <div class="sd-enquiry__head">
    <h2 class="sd-enquiry__title">Ask about Sheepdog</h2>
    <p class="sd-enquiry__lede">
      Tell us a little about your site and Toby will get back to you by email.
    </p>
  </div>
  <Form
    name="Sheepdog enquiry"
    action={SHEEPDOG_FORM_ENDPOINT}
    recaptcha={RECAPTCHA_SITE_KEY}
    successMessage="Thanks. Toby will be in touch by email."
    errorMessage="That didn't send. Please try again, or email hello@electricsheep.design."
  >
    <div class="sd-enquiry__row">
      <Input label="Name" name="name" autocomplete="name" required />
      <Input variant="email" name="email" required />
    </div>
    <div class="sd-enquiry__row">
      <Input
        label="Organisation"
        name="organisation"
        autocomplete="organization"
      />
      <Input
        label="Website"
        name="site"
        placeholder="yoursite.com"
        inputmode="url"
        autocomplete="url"
      />
    </div>
    <Select
      label="Which plan are you looking at?"
      name="plan"
      placeholder="Choose a plan"
      options={["Content", "Studio", "Team", "Not sure yet"]}
    />
    <Textarea
      label="What would you like Sheepdog to look after?"
      name="message"
      placeholder="News, events, team pages, how often things change..."
    />
    <input type="hidden" name="page" value="/sheepdog" />
    <Button type="submit">Send enquiry</Button>
    <p class="sd-enquiry__fine">
      We only use your details to reply. See our <a href="/privacy"
        >privacy policy</a
      >. This form is protected by reCAPTCHA, and Google's <a
        href="https://policies.google.com/privacy"
        target="_blank"
        rel="noopener">Privacy Policy</a
      > and <a
        href="https://policies.google.com/terms"
        target="_blank"
        rel="noopener">Terms of Service</a
      > apply.
    </p>
  </Form>
</Modal>

<style is:global>
  @layer components {
    .sd-enquiry .modal_content {
      max-width: 40rem;
    }
    .sd-enquiry__head {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-bottom: var(--space-6);
      padding-right: var(--space-8);
    }
    .sd-enquiry__title {
      font-size: var(--h3);
    }
    .sd-enquiry__lede {
      font-size: var(--text-main);
      line-height: var(--line-height-large);
      color: color-mix(in lab, var(--text) 72%, var(--background));
    }
    .sd-enquiry .form_fields {
      row-gap: var(--space-5);
    }
    .sd-enquiry__row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
    .sd-enquiry .form_fields > .button,
    .sd-enquiry .form_fields > button {
      align-self: flex-start;
    }
    .sd-enquiry__fine {
      font-size: var(--text-small);
      line-height: var(--line-height-large);
      color: color-mix(in lab, var(--text) 60%, var(--background));
    }
    .sd-enquiry__fine a {
      text-decoration: underline;
      color: inherit;
    }
    @media (width < 40rem) {
      .sd-enquiry__row {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
