---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Icon from "@/components/Media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";

type HeadingTag = "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The item's title, on the control that opens it. */
  heading?: string;
  /** Heading level, for the page outline. Every accordion heading is the same size. */
  headingTag?: HeadingTag;
  /** Opens the item on load. */
  open?: boolean;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  open = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && heading && content && (
    <details
      class:list={["accordion_item", className]}
      open={open}
      data-accordion-group
      {...rest}
    >
      <summary class="accordion_toggle">
        <Heading tag={headingTag} variant="h5" class="accordion_title">
          {heading}
        </Heading>
        <Icon class="accordion_icon" src={arrow} variant="small" />
      </summary>

      <div class="accordion_body margin-trim">
        <Fragment set:html={content} />
      </div>
    </details>
  )
}

<style is:global>
  @layer components {
    .accordion_item {
      interpolate-size: allow-keywords;
      border-bottom: var(--border-width) solid var(--border);
      transition: border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-bottom-color: currentcolor;
        }
      }
    }

    .accordion_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: var(--space-5);
      list-style: none;
      cursor: pointer;
      &::-webkit-details-marker {
        display: none;
      }
    }

    .accordion_title {
      margin-block: 0;
    }

    .accordion_icon {
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .accordion_item:is([open], .stacki-opened) .accordion_icon,
    .stacki-designer .accordion_wrap.preview .accordion_icon {
      rotate: -90deg;
    }

    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
      transition:
        block-size var(--open-duration) var(--open-ease),
        content-visibility var(--open-duration) var(--open-ease) allow-discrete;
    }

    .accordion_item:is([open], .stacki-opened)::details-content,
    .stacki-designer .accordion_wrap.preview .accordion_item::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    /* The content box clips while it animates open. Lumos trims each p up to
       its cap height, so the first line's ascenders sit above the box edge:
       pad the top so they aren't cut off, and take the same off the toggle. */
    .accordion_item[open] > .accordion_toggle {
      padding-bottom: var(--space-3);
    }
    .accordion_body {
      padding-top: var(--space-2);
      padding-bottom: var(--space-5);
    }

    /* Focus ring: keyboard only, drawn inside the row so it doesn't cross the
       rules. A mouse or touch press on the toggle shows no ring. */
    .accordion_toggle:focus-visible {
      /* Room either side so the ring clears the title and the arrow, with
         the negative margin keeping both aligned to the rules. */
      margin-inline: calc(var(--space-3) * -1);
      padding-inline: var(--space-3);
      outline-offset: calc(var(--focus-width) * -1);
      border-radius: var(--radius-small);
    }
    .accordion_item[data-pointer] > .accordion_toggle:focus-visible {
      outline: none;
    }
  }
</style>

<script>
  // Mark presses made with a pointer so the focus ring stays for keyboards.
  for (const toggle of document.querySelectorAll<HTMLElement>(
    ".accordion_toggle",
  )) {
    const item = toggle.parentElement as HTMLElement;
    toggle.addEventListener("pointerdown", () => {
      item.dataset.pointer = "";
    });
    toggle.addEventListener("keydown", () => {
      delete item.dataset.pointer;
    });
    toggle.addEventListener("blur", () => {
      delete item.dataset.pointer;
    });
  }
</script>
