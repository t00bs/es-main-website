---
// Full-width feature/CTA image card: 62px headline + pixel link, bottom-left.
import PixelLink from './PixelLink.astro';

interface Props {
  src?: string;
  headline: string;
  linkText?: string;
  href?: string;
}

const { src, headline, linkText, href = '#' } = Astro.props;
---

<div class="feature-card">
  {src && <img src={src} alt="" loading="lazy" />}
  <div class="feature-card__overlay"></div>
  <span class="feature-card__headline" style={`bottom: ${linkText ? 77 : 30}px;`}>{headline}</span>
  {
    linkText && (
      <div class="feature-card__link">
        <PixelLink href={href}>{linkText}</PixelLink>
      </div>
    )
  }
</div>

<style>
  .feature-card {
    position: relative;
    width: 100%;
    height: 515px;
    overflow: hidden;
    background-color: var(--surface-placeholder);
  }
  .feature-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-card__overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-protect);
  }
  .feature-card__headline {
    position: absolute;
    left: var(--card-pad);
    max-width: 410px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    color: var(--es-cream);
  }
  .feature-card__link {
    position: absolute;
    left: var(--card-pad);
    bottom: 30px;
  }
</style>
