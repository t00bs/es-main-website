---
// "Numbers, not vibes": dark strip of headline results.
import SectionLabel from './SectionLabel.astro';
import results from '../data/results.json';
---

<div class="inverse-section results-strip">
  <SectionLabel highlight="not vibes">Numbers,</SectionLabel>
  <div class="results-strip__grid">
    {
      results.map((item) => (
        <div class="result">
          <span class="result__figure">{item.figure}</span>
          <span class="result__caption">{item.caption}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .results-strip {
    padding: var(--section-pad) var(--page-margin);
  }
  .results-strip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--grid-gap);
    margin-top: 48px;
  }
  .result {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid var(--rule-hairline);
    padding-top: 20px;
  }
  .result__figure {
    font-family: var(--font-sans);
    font-weight: 400;
    /* Sized so the longest figure fits a 4-up column without wrapping. */
    font-size: clamp(34px, 3.1vw, 52px);
    line-height: var(--leading-tight);
    color: var(--text-on-inverse);
    white-space: nowrap;
  }
  .result__caption {
    font-family: var(--font-pixel);
    font-size: var(--text-pixel-label);
    letter-spacing: var(--tracking-pixel);
    line-height: 1.3;
    color: var(--text-on-inverse);
    opacity: 0.7;
    text-wrap: pretty;
  }
</style>
