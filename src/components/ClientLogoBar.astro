---
import caseStudies from '../data/case-studies.json';
const clientLogos = [];

// "Trusted by" bar between hairlines. Case studies that are `featured` and
// carry a `clientLogo` render their logo here; while none qualify, the bar
// falls back to the text names in client-logos.json.



const featuredLogos = [...caseStudies]
  .sort((a, b) => a.order - b.order)
  .filter((item) => item.featured && item.clientLogoNew);
---
<div class="logo-bar">
  <div class="logo-bar__row">
    <span class="logo-bar__label">Trusted by:</span>
    {
      featuredLogos.length > 0
        ? featuredLogos.map((item) => (
            <img
              class="logo-bar__logo"
              src={item.clientLogoNew}
              alt={item.client}
              loading="lazy"
              style={item.clientLogoWidth ? `--logo-w: ${item.clientLogoWidth}px;` : undefined}
            />
          ))
        : clientLogos.map((item) => <span class="logo-bar__name">{item.name}</span>)
    }
  </div>
</div>
<style>
  .logo-bar {
    padding: 0 var(--page-margin) var(--section-pad) var(--page-margin);
  }
  .logo-bar__row {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 20px 0;
    border-top: 1px solid var(--rule-hairline);
    border-bottom: 1px solid var(--rule-hairline);
  }
  .logo-bar__label {
    font-family: var(--font-pixel);
    font-size: var(--text-pixel-label);
    letter-spacing: var(--tracking-pixel);
    color: var(--text-primary);
  }
  .logo-bar__name {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 24px;
    line-height: var(--leading-tight);
    color: var(--text-primary);
    opacity: 0.5;
    white-space: nowrap;
  }
  /* Logos render monochrome at the same half-strength as the text names:
     flattened to ink in light mode, inverted to cream in dark. Per-logo
     widths arrive as --logo-w so breakpoints can scale them proportionally. */
  .logo-bar__logo {
    height: 32px;
    width: auto;
    display: block;
    opacity: 0.5;
    filter: brightness(0);
  }
  .logo-bar__logo[style] {
    width: var(--logo-w);
    height: auto;
  }
  :global([data-theme='dark']) .logo-bar__logo {
    filter: brightness(0) invert(1);
  }

  /* Below desktop the per-logo widths give way to uniform boxes: every logo
     is contained in the same footprint so heavy wordmarks and delicate marks
     read at even weight, in centred rows. The label takes its own line. */
  @media (max-width: 960px) {
    .logo-bar__row {
      justify-content: center;
      gap: 28px 44px;
    }
    .logo-bar__label {
      flex-basis: 100%;
    }
    .logo-bar__logo,
    .logo-bar__logo[style] {
      width: 128px;
      height: 44px;
      object-fit: contain;
    }
  }

  @media (max-width: 720px) {
    .logo-bar__row {
      gap: 20px 32px;
    }
    .logo-bar__logo,
    .logo-bar__logo[style] {
      width: 104px;
      height: 40px;
    }
  }
</style>
