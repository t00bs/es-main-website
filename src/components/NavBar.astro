---
// Site header: logo lockup left, text links right, theme toggle last.
// Links sit on the logo's baseline; the toggle is an icon switcher
// (moon in light mode, sun in dark). On mobile the links live in a
// full-screen menu behind an animated burger.
---

<header class="nav-bar">
  <a href="/" aria-label="Electric Sheep home" class="nav-bar__logo">
    <img class="logo-dark" src="/assets/logo/es-logo-dark.svg" alt="Electric Sheep" />
    <img class="logo-cream" src="/assets/logo/es-logo-cream.svg" alt="Electric Sheep" />
  </a>
  <nav>
    <a href="/work">Work</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode">
      <svg
        class="icon-moon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg
        class="icon-sun"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.5"></circle>
        <line x1="12" y1="1.5" x2="12" y2="4"></line>
        <line x1="12" y1="20" x2="12" y2="22.5"></line>
        <line x1="1.5" y1="12" x2="4" y2="12"></line>
        <line x1="20" y1="12" x2="22.5" y2="12"></line>
        <line x1="4.9" y1="4.9" x2="6.7" y2="6.7"></line>
        <line x1="17.3" y1="17.3" x2="19.1" y2="19.1"></line>
        <line x1="4.9" y1="19.1" x2="6.7" y2="17.3"></line>
        <line x1="17.3" y1="6.7" x2="19.1" y2="4.9"></line>
      </svg>
    </button>
  </nav>
  <button type="button" class="burger" data-menu-toggle aria-label="Open menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<style>
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 24px var(--page-margin) 8px var(--page-margin);
    gap: 24px;
    flex-wrap: wrap;
  }
  .nav-bar__logo {
    display: block;
    width: 256px;
  }
  .nav-bar__logo img {
    width: 100%;
    height: auto;
    display: block;
  }
  .nav-bar__logo .logo-cream {
    display: none;
  }
  :global([data-theme='dark']) .nav-bar__logo .logo-dark {
    display: none;
  }
  :global([data-theme='dark']) .nav-bar__logo .logo-cream {
    display: block;
  }
  nav {
    display: flex;
    gap: var(--nav-gap);
    align-items: center;
  }
  nav a {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-body);
    line-height: var(--leading-none);
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .theme-toggle {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--text-primary);
    display: flex;
    transition: opacity 0.2s ease;
  }
  .theme-toggle:hover {
    opacity: 0.55;
  }
  .theme-toggle svg {
    display: block;
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }
  /* Burger: hidden on desktop, three lines folding into an X when open. */
  .burger {
    display: none;
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
    z-index: 60;
    width: 28px;
    height: 24px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 5px;
    color: var(--text-primary);
  }
  .burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.6, 0.2, 1),
      opacity 0.2s ease;
  }
  .nav-bar.open .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-bar.open .burger span:nth-child(2) {
    opacity: 0;
  }
  .nav-bar.open .burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 720px) {
    .nav-bar__logo {
      width: 180px;
    }
    .burger {
      display: flex;
    }
    /* The nav becomes a full-screen menu that fades and rises in. */
    nav {
      position: fixed;
      inset: 0;
      z-index: 50;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 32px;
      padding: 0 var(--page-margin);
      background: var(--surface-page);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition:
        opacity 0.3s ease,
        transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1),
        visibility 0s linear 0.35s;
    }
    .nav-bar.open nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 0.3s ease,
        transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1);
    }
    nav a {
      font-size: var(--text-card-title);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span,
    nav {
      transition: none;
    }
  }
</style>

<script>
  function currentTheme(): string {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateLabel(button: HTMLButtonElement) {
    button.setAttribute(
      'aria-label',
      currentTheme() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
    );
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    updateLabel(button);
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('es-theme', next);
      } catch {
        /* private browsing */
      }
      updateLabel(button);
    });
  });

  document.querySelectorAll<HTMLElement>('.nav-bar').forEach((bar) => {
    const burger = bar.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!burger) return;

    const setOpen = (open: boolean) => {
      bar.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => setOpen(!bar.classList.contains('open')));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && bar.classList.contains('open')) setOpen(false);
    });
  });
</script>
