---
// Black footer: giant full-bleed logotype, then contact rows in cream.
// The Lumos Footer slot, rewritten for Electric Sheep. Rendered by BaseLayout.
import { SITE_NAME } from "@/consts.ts";
import CookieConsent from "@/components/Site/CookieConsent.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Studio address, shown bottom-left. */
  address?: string;
  /** Contact address, rendered as a mailto link. */
  email?: string;
  /** Copyright line. Newlines are preserved. */
  legal?: string;
}

const {
  render = true,
  address = "10 Minden Street, St Helier, JE2 4WR",
  email = "hello@electricsheep.design",
  legal = "© 2026 Electric Sheep Limited.\nAll rights reserved.",
} = Astro.props;
---

{
  render && (
    <footer class="site_footer theme-dark">
      <img
        src="/assets/logo/es-logo-cream.svg"
        alt={SITE_NAME}
        loading="lazy"
      />
      <div class="site_footer_rows">
        <span>{address}</span>
        <a href={`mailto:${email}`}>{email}</a>
        <div class="site_footer_legal">
          <a href="/privacy">Privacy</a>
          <a href="/cookies">Cookie policy</a>
          <a href="#cookie-settings">Cookie settings</a>
          <span>{legal}</span>
        </div>
      </div>
    </footer>
  )
}

{/* Outside the render guard: the banner is needed on every page. */}
<CookieConsent />

<style is:global>
  @layer components {
    .site_footer {
      /* The footer is the one surface that goes to true black rather than the
         ink used by the dark theme — it reads as the end of the page. */
      --background: #000000;

      background-color: var(--background);
      color: var(--text);
      /* Held to the same 90rem measure as the page content above it. */
      padding: var(--space-7)
        max(var(--site-margin), (100% - var(--max-width-main)) / 2)
        var(--site-margin);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);

      & > img {
        width: 100%;
        height: auto;
        display: block;
      }
    }

    /* Below 64rem the three blocks stack in one left-aligned column; from
       there they sit in a row — address left, email truly centred, legal
       right. A wrapping space-between row left a right-aligned legal block
       stranded on the left whenever it wrapped. */
    .site_footer_rows {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);

      & span,
      & a {
        font-size: var(--text-main);
        line-height: var(--line-height-small);
        color: var(--text);
        white-space: pre-line;
        transition: opacity var(--hover-duration) var(--hover-ease);
      }
      & a:hover {
        opacity: 0.6;
      }
    }

    .site_footer_legal {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    @media (width >= 64rem) {
      .site_footer_rows {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
      }
      .site_footer_rows > a {
        justify-self: center;
      }
      .site_footer_legal {
        justify-self: end;
        align-items: flex-end;
        text-align: right;
      }
    }
  }
</style>
