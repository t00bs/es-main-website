---
// Every page's shell. Wraps the Lumos BaseLayout (which renders BaseHead, the
// skip link, Nav, <main> and Footer) with Tag Manager and the scroll-reveal
// motion. The site is dark: `theme-dark` goes on <html> at build time, so
// there is no toggle and nothing to restore before first paint. A page adds
// its own tags to <head> through the `head` slot.
import BaseLayout from "./BaseLayout.astro";
import TagManager from "@/components/Site/TagManager.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;
---

<BaseLayout theme="dark" {...Astro.props}>
  <Fragment slot="head">
    <TagManager />
    {/* ARD's link relation: points AI clients at the agent catalog. */}
    <link rel="ard" href="/.well-known/ard.json" />
    <script>
      import "@/scripts/reveal";
    </script>
    <slot name="head" />
  </Fragment>

  <slot />
</BaseLayout>
