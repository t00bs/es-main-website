---
// Every page's shell. Wraps the Lumos BaseLayout (which renders BaseHead, the
// skip link, Nav, <main> and Footer) with the scroll-reveal motion. The site
// is dark: `theme-dark` goes on <html> at build time, so there is no toggle
// and nothing to restore before first paint.
import BaseLayout from "./BaseLayout.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;
---

<BaseLayout theme="dark" {...Astro.props}>
  <Fragment slot="head">
    <script>
      import "@/scripts/reveal";
    </script>
  </Fragment>

  <slot />
</BaseLayout>
